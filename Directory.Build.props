<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>Jouko Broström</Company>
    <Authors>Jouko Broström</Authors>
    <Product>Cyberdrome Cockpit</Product>
    <Copyright>Copyright (C) 2026 Jouko Broström. GPL-3.0-or-later.</Copyright>
    <Version>1.1.1</Version>
    <!-- Samma produktversion i varje bygge (SignPath): ingen commit-hash i ProductVersion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- Programmets texter (L.T / L.F) finns i Cyberdrome.Localization. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Cyberdrome.Localization'">
    <Using Include="Cyberdrome.Localization" />
  </ItemGroup>
</Project>
