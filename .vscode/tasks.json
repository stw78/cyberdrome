    { "label": "build radio", "command": "powershell", "type": "process", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/android/CyberdromeRadio/build.ps1"], "problemMatcher": [] },
