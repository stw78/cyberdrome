<!-- Cyberdrome Cockpit: toppfält, grupperad sidomeny, sidor med rubrik + en förklarande mening, kort, statusrad. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cyberdrome.App.ViewModels"
        xmlns:p="using:Cyberdrome.Core.Profiles"
        xmlns:avm="using:Cyberdrome.Vm"
        xmlns:views="using:Cyberdrome.App.Views"
        xmlns:obdt="using:Cyberdrome.Obd.Testing"
        xmlns:app="using:Cyberdrome.App"
        xmlns:l="using:Cyberdrome.App"
        xmlns:cardb="using:Cyberdrome.Core.CarDb"
        x:Class="Cyberdrome.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cyberdrome Cockpit"
        Icon="/Assets/cyberdrome.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!-- ================= Toppfält (64 px) ================= -->
    <Border x:Name="TopBar" DockPanel.Dock="Top" Height="64" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="/Assets/cyberdrome-256.png" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="Cyberdrome Cockpit" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Bilmodell som en pill med bilikon -->
        <Border Grid.Column="1" Margin="28,0,0,0" Background="{StaticResource Fill}" CornerRadius="999" Padding="14,0,4,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <l:LineIcon Data="{StaticResource Icon.car}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="250" BorderThickness="0"
                      Background="Transparent" ToolTip.Tip="{l:T Ui_CarModel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="p:CarProfile">
                  <TextBlock Text="{Binding ListName}" FontWeight="Medium" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>

        <!-- Status: bilen igång -->
        <Border Grid.Column="2" Classes="pill" Classes.off="{Binding !Ignition}" Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" />
            <TextBlock Text="{Binding CarRunningText}" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="plain" IsVisible="{Binding UpdateAvailable}" Command="{Binding GoToPageCommand}" CommandParameter="10"
                  ToolTip.Tip="{Binding UpdateStatus}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <l:LineIcon Data="{StaticResource Icon.download}" Foreground="{StaticResource Accent}" Size="16" />
              <TextBlock Text="{Binding UpdateVersion, Converter={x:Static vm:Conv.Format}, ConverterParameter=Release_UpdateBadge0}" />
            </StackPanel>
          </Button>
          <Button Classes="icon" Click="AboutClick" ToolTip.Tip="{l:T Ui_About}">
            <l:LineIcon Data="{StaticResource Icon.info}" />
          </Button>
          <Button Classes="icon" Click="LicenseClick" ToolTip.Tip="{l:T Ui_Licence}">
            <l:LineIcon Data="{StaticResource Icon.file-text}" />
          </Button>
          <!-- Android på/av (när Android är installerat) -->
          <Border Classes="androidswitch" IsVisible="{Binding AndroidInstalled}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <l:LineIcon Data="{StaticResource Icon.smartphone}" Foreground="{StaticResource Accent}" Size="16" VerticalAlignment="Center" />
              <TextBlock Text="Android" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding AndroidOn}" IsEnabled="{Binding AndroidSwitchEnabled}" OnContent="" OffContent="" MinWidth="0" ToolTip.Tip="{Binding AndroidStatus}" />
              <ProgressBar IsIndeterminate="True" Width="28" Height="4" MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding AndroidSwitching}" />
              <TextBlock Classes="small" Text="{Binding AndroidSwitchText}" VerticalAlignment="Center" MinWidth="58" />
            </StackPanel>
          </Border>
          <Button Classes="primary" Command="{Binding InstallAndroidCommand}" IsVisible="{Binding AndroidCanInstall}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <l:LineIcon Data="{StaticResource Icon.download}" Foreground="White" Size="16" />
              <TextBlock Text="{l:T Ui_InstallAndroid}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= Statusrad (34 px) ================= -->
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="34" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="22">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{Binding AndroidRunning, Converter={x:Static vm:Conv.DotBrush}}" />
            <TextBlock Classes="small" Text="{Binding AndroidStatusShort}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{Binding ObdRunning, Converter={x:Static vm:Conv.DotBrush}}" />
            <TextBlock Classes="small" Text="{Binding ObdStatus}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{StaticResource Purple}" />
            <TextBlock Classes="small" VerticalAlignment="Center"
                       Text="{Binding SelectedProfile.DisplayName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_StatusCarModel}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="small" Text="{Binding VersionText}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ================= Sidomeny (248 px, grupperad) ================= -->
    <Border x:Name="SideBar" DockPanel.Dock="Left" Width="248" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,6,12,14">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="small" Margin="12,8,4,0" Text="{l:T Ui_AllCarModelsAndCodingData}" />
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="group" Text="{l:T Nav_GroupCar}" />
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsOverview, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="0">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.house}" /><TextBlock Text="{l:T Nav_Overview}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsDrives, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="4">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.route}" /><TextBlock Text="{l:T Nav_Drives}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsMap, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="5">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.map}" /><TextBlock Text="{l:T Nav_Map}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsFeatures, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="1">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.key-round}" /><TextBlock Text="{l:T Nav_HiddenFeatures}" /></StackPanel>
            </RadioButton>

            <TextBlock Classes="group" Text="{l:T Nav_GroupTest}" />
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsTests, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="6">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.square-check}" /><TextBlock Text="{l:T Nav_TestCases}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsLog, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="2">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.list}" /><TextBlock Text="{l:T Nav_ObdLog}" /></StackPanel>
            </RadioButton>

            <TextBlock Classes="group" Text="{l:T Nav_GroupData}" />
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsCars, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="7">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.car}" /><TextBlock Text="{l:T Nav_CarModels}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsCarDb, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="9">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.database}" /><TextBlock Text="{l:T Nav_CarDatabase}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsSource, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="8">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.plug}" /><TextBlock Text="{l:T Nav_ObdSource}" /></StackPanel>
            </RadioButton>

            <TextBlock Classes="group" Text="{l:T Nav_GroupSystem}" />
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsAndroid, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="3">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.smartphone}" /><TextBlock Text="{l:T Nav_Android}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding GoToPageCommand}" CommandParameter="10">
              <StackPanel Orientation="Horizontal" Spacing="12"><l:LineIcon Data="{StaticResource Icon.settings}" /><TextBlock Text="{l:T Nav_Settings}" /></StackPanel>
            </RadioButton>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ================= Innehåll ================= -->
    <Grid x:Name="ContentGrid" Margin="28,22,28,22">
      <Border Classes="warnbox" IsVisible="{Binding HasError}" VerticalAlignment="Top" ZIndex="5">
        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
      </Border>

      <!-- ================= ÖVERSIKT ================= -->
      <DockPanel x:Name="OverviewPage" IsVisible="{Binding IsOverview}">
        <StackPanel x:Name="OverviewTitle" DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Nav_Overview}" />
          <TextBlock Classes="lead" Text="{l:T Lead_Overview}" />
        </StackPanel>
        <Grid x:Name="OverviewGrid" ColumnDefinitions="*,340" ColumnSpacing="20">
          <Border x:Name="OverviewCard" Classes="card">
            <DockPanel>
              <!-- Verktygsrad: skärm, orientering, tema, skal – radbryts i stället för att skäras av; fullskärm till höger -->
              <Grid x:Name="OverviewHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
                  <!-- Android på/av: första platsen i verktygsraden, tydligt synlig -->
                  <Border Classes="androidswitch" IsVisible="{Binding AndroidInstalled}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Android" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <ToggleSwitch IsChecked="{Binding AndroidOn}" IsEnabled="{Binding AndroidSwitchEnabled}" OnContent="" OffContent="" MinWidth="0" ToolTip.Tip="{Binding AndroidStatus}" />
                      <ProgressBar IsIndeterminate="True" Width="28" Height="4" MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding AndroidSwitching}" />
                      <TextBlock Classes="small" Text="{Binding AndroidSwitchText}" VerticalAlignment="Center" MinWidth="58" />
                    </StackPanel>
                  </Border>
                  <Button Classes="primary" Command="{Binding InstallAndroidCommand}" IsVisible="{Binding AndroidCanInstall}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.download}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_InstallAndroid}" /></StackPanel>
                  </Button>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <l:LineIcon Data="{StaticResource Icon.monitor}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding ScreenPresetList}" SelectedItem="{Binding SelectedScreenPreset}" Width="205" ToolTip.Tip="{l:T Ui_Screen}" />
                  </StackPanel>
                  <Border Classes="seg">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Classes="seg" GroupName="ScreenOrientationQuick" Content="{l:T Ui_Landscape}" IsChecked="{Binding ScreenLandscape}" />
                      <RadioButton Classes="seg" GroupName="ScreenOrientationQuick" Content="{l:T Ui_Portrait}" IsChecked="{Binding ScreenPortrait}" />
                    </StackPanel>
                  </Border>
                  <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" Width="185" ToolTip.Tip="{l:T Ui_ThemeInAndroid}" />
                  <ComboBox ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding SelectedSkinOption}" Width="185" ToolTip.Tip="{l:T Ui_Skin}" />
                </WrapPanel>
                <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top" Margin="12,0,0,0" Click="ToggleFullscreenClick" ToolTip.Tip="{l:T Ui_FullscreenTip}">
                  <l:LineIcon Data="{StaticResource Icon.maximize-2}" />
                </Button>
              </Grid>

              <!-- Under skärmen: OBD-adresser och (när Android är igång) appar och rattknappar -->
              <StackPanel x:Name="OverviewFooter" DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <l:LineIcon Data="{StaticResource Icon.plug}" Foreground="{StaticResource Muted}" Size="16" VerticalAlignment="Center" />
                  <TextBlock Classes="small" Text="OBD" VerticalAlignment="Center" />
                  <SelectableTextBlock Classes="code" FontSize="12" Text="{Binding ObdAddress}" VerticalAlignment="Center" />
                  <TextBlock Classes="small" Text="·" VerticalAlignment="Center" IsVisible="{Binding HasAndroidObdAddress}" />
                  <TextBlock Classes="small" Text="Android" VerticalAlignment="Center" IsVisible="{Binding HasAndroidObdAddress}" />
                  <SelectableTextBlock Classes="code" FontSize="12" Text="{Binding AndroidObdAddress}" VerticalAlignment="Center" IsVisible="{Binding HasAndroidObdAddress}" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding CanControlScreen}">
                  <Button Classes="primary" Click="PickApk">
                    <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.package}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_InstallApp}" /></StackPanel>
                  </Button>
                  <Button Classes="plain" Command="{Binding InstallRadioAppCommand}" ToolTip.Tip="{l:T Ui_OurExampleAppRadioSteeringWheel}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.radio}" Size="16" /><TextBlock Text="{l:T Ui_InstallCyberdromeRadio}" /></StackPanel>
                  </Button>
                  <Button Classes="plain" Command="{Binding InstallTestAppCommand}" ToolTip.Tip="{l:T Ui_FreeOBDAppGPLv3FromF}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.gauge}" Size="16" /><TextBlock Text="{l:T Ui_InstallTestAppAndrOBD}" /></StackPanel>
                  </Button>
                  <Button Classes="plain" Command="{Binding InstallMapAppCommand}" ToolTip.Tip="{l:T Ui_FreeMapAppApache20}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.map}" Size="16" /><TextBlock Text="{l:T Ui_InstallMapAppOrganicMaps}" /></StackPanel>
                  </Button>
                  <Button Classes="icon" Command="{Binding RestartForegroundAppCommand}" ToolTip.Tip="{l:T Ui_RestartApp}">
                    <l:LineIcon Data="{StaticResource Icon.rotate-ccw}" />
                  </Button>
                  <Button Classes="icon" Command="{Binding TakeScreenshotCommand}" ToolTip.Tip="{l:T Ui_TakeScreenshot}">
                    <l:LineIcon Data="{StaticResource Icon.camera}" />
                  </Button>
                  <TextBlock Classes="small" Text="{l:T Ui_SteeringWheelButtons}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <Border Classes="seg">
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="plain" Background="Transparent" Content="{l:T Ui_Previous}" ToolTip.Tip="KEYCODE_MEDIA_PREVIOUS"
                              Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Previous}" />
                      <Button Classes="plain" Background="Transparent" Content="{l:T Ui_Next}" ToolTip.Tip="KEYCODE_MEDIA_NEXT"
                              Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Next}" />
                      <Button Classes="plain" Background="Transparent" Content="{l:T Ui_Mute}" ToolTip.Tip="KEYCODE_VOLUME_MUTE"
                              Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Mute}" />
                    </StackPanel>
                  </Border>
                </WrapPanel>
                <TextBlock Classes="small" Text="{Binding ScreenshotStatus}" IsVisible="{Binding CanControlScreen}" />
                <TextBlock Classes="small" Text="{Binding ScreenFpsText}" IsVisible="{Binding ScreenFpsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Border Classes="note" IsVisible="{Binding TestAppHelpVisible}">
                  <TextBlock Text="{Binding TestAppHelp}" TextWrapping="Wrap" FontSize="12" />
                </Border>
                <TextBlock Classes="small" Text="{Binding LookStatus}" />
              </StackPanel>

              <!-- Skärmen med skal: skalas jämnt så att den alltid ryms (se SkinHost); fullskärmsknapp ovanpå i fullskärm -->
              <Grid>
                <views:SkinHost x:Name="SkinFrame" Skin="{Binding ActiveSkin}">
                  <Grid>
                    <!-- WSL2: Cuttlefishs WebRTC-ström (video + tryck) i stället för skärmdumpar -->
                    <views:WebScreenHost x:Name="WebScreen" Url="{Binding WebScreenUrl}" IsVisible="{Binding HasWebScreen}" />
                    <Image x:Name="AndroidScreen" Source="{Binding ScreenFrame}" Stretch="Uniform" Cursor="Hand"
                           IsVisible="{Binding HasScreenFrame}"
                           PointerPressed="ScreenPointerPressed" PointerMoved="ScreenPointerMoved" PointerReleased="ScreenPointerReleased"
                           RenderOptions.BitmapInterpolationMode="MediumQuality" />
                    <Border Background="#F5F6F8" IsVisible="{Binding ShowScreenPlaceholder}">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460" Margin="18,14">
                          <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
                            <l:LineIcon Data="{StaticResource Icon.smartphone}" Size="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding AndroidStatusShort}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" TextAlignment="Center" Text="{Binding AndroidStatus}" />
                          <StackPanel Spacing="6" IsVisible="{Binding InstallProgressVisible}">
                            <ProgressBar Minimum="0" Maximum="100" Height="6" CornerRadius="3"
                                         Value="{Binding InstallProgressValue}" IsIndeterminate="{Binding InstallProgressIndeterminate}" />
                            <TextBlock Classes="small" TextAlignment="Center" Text="{Binding InstallProgressText}" />
                          </StackPanel>
                          <Button Classes="primary" HorizontalAlignment="Center" Content="{l:T Ui_ShowTheAndroidScreen}" Command="{Binding OpenAndroidScreenCommand}" IsVisible="{Binding AndroidRunning}" />
                          <Button Classes="link" HorizontalAlignment="Center" Content="{l:T Ui_ShowLog}" Command="{Binding GoToPageCommand}" CommandParameter="3" IsVisible="{Binding AndroidStartFailed}" />
                          <TextBlock Classes="small" TextAlignment="Center" Text="{l:T Ui_YouCanAlreadyTestOBDConnect}" />
                          <Border Classes="mono" HorizontalAlignment="Center" Background="White">
                            <SelectableTextBlock Classes="code" Text="{Binding ObdAddress}" TextWrapping="Wrap" TextAlignment="Center" />
                          </Border>
                        </StackPanel>
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </views:SkinHost>
                <Button x:Name="ExitFullscreenButton" IsVisible="False" Click="ToggleFullscreenClick"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Padding="14,8" CornerRadius="999"
                        Background="#CC1C1C1E" ToolTip.Tip="Esc / F11">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <l:LineIcon Data="{StaticResource Icon.minimize-2}" Foreground="White" Size="16" />
                    <TextBlock Text="{l:T Ui_ExitFullscreen}" Foreground="White" />
                  </StackPanel>
                </Button>
              </Grid>
            </DockPanel>
          </Border>

          <!-- Höger kolumn (340 px) -->
          <ScrollViewer x:Name="CarPanel" Grid.Column="1" Padding="0,0,4,0">
            <StackPanel Spacing="16">
              <!-- Bilen just nu: 2x2 rutor med dragbara reglage -->
              <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                  <TextBlock Classes="h2" Text="{l:T Ui_TheCarRightNow}" />
                  <Border Classes="warnbox" Padding="10,6" IsVisible="{Binding IsPlayingDrive}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontWeight="SemiBold" Text="{Binding PlayingName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_PlaybackRunning}" />
                  </Border>
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" IsEnabled="{Binding ManualControl}">
                    <Border Classes="tile">
                      <StackPanel>
                        <TextBlock Classes="small" Text="{l:T Ui_Speed}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Classes="big" Text="{Binding Speed, StringFormat='{}{0:0}'}" />
                          <TextBlock Classes="small" Text="km/h" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <Slider Classes="thin" Minimum="0" Maximum="250" Value="{Binding Speed}">
                          <Slider.Resources>
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#0A66FF" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#0A66FF" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#0A66FF" />
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#0A66FF" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#0A66FF" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#0A66FF" />
                          </Slider.Resources>
                        </Slider>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="tile">
                      <StackPanel>
                        <TextBlock Classes="small" Text="{l:T Ui_EngineSpeed}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Classes="big" Text="{Binding Rpm, StringFormat='{}{0:0}'}" />
                          <TextBlock Classes="small" Text="{l:T Ui_UnitRpm}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <Slider Classes="thin" Minimum="0" Maximum="7000" Value="{Binding Rpm}">
                          <Slider.Resources>
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#5E5CE6" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#5E5CE6" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#5E5CE6" />
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#5E5CE6" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#5E5CE6" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#5E5CE6" />
                          </Slider.Resources>
                        </Slider>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="tile">
                      <StackPanel>
                        <TextBlock Classes="small" Text="{l:T Ui_Coolant}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Classes="big" Text="{Binding Coolant, StringFormat='{}{0:0}'}" />
                          <TextBlock Classes="small" Text="°C" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <Slider Classes="thin" Minimum="-20" Maximum="130" Value="{Binding Coolant}">
                          <Slider.Resources>
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF9F0A" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF9F0A" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF9F0A" />
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF9F0A" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF9F0A" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF9F0A" />
                          </Slider.Resources>
                        </Slider>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Classes="tile">
                      <StackPanel>
                        <TextBlock Classes="small" Text="{l:T Ui_Fuel}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Classes="big" Text="{Binding Fuel, StringFormat='{}{0:0}'}" />
                          <TextBlock Classes="small" Text="%" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <Slider Classes="thin" Minimum="0" Maximum="100" Value="{Binding Fuel}">
                          <Slider.Resources>
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#34C759" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#34C759" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#34C759" />
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#34C759" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#34C759" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#34C759" />
                          </Slider.Resources>
                        </Slider>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding ManualControl}">
                    <TextBlock Text="{l:T Ui_Gear}" VerticalAlignment="Center" FontWeight="Medium" />
                    <Border Grid.Column="1" Classes="seg" HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg" GroupName="gear" Content="P" IsChecked="{Binding GearP}" />
                        <RadioButton Classes="seg" GroupName="gear" Content="R" IsChecked="{Binding GearR}" />
                        <RadioButton Classes="seg" GroupName="gear" Content="N" IsChecked="{Binding GearN}" />
                        <RadioButton Classes="seg" GroupName="gear" Content="D" IsChecked="{Binding GearD}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ManualControl}">
                    <TextBlock Text="{l:T Ui_Ignition}" VerticalAlignment="Center" FontWeight="Medium" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Ignition}" OnContent="" OffContent="" MinWidth="0" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ManualControl}">
                    <TextBlock Text="{l:T Ui_Dark}" VerticalAlignment="Center" FontWeight="Medium" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Dark}" OnContent="" OffContent="" MinWidth="0" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Felkoder -->
              <Border Classes="card" Padding="18">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource ErrorSoft}">
                      <l:LineIcon Data="{StaticResource Icon.triangle-alert}" Foreground="{StaticResource Error}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="h2" Text="{l:T Ui_TroubleCodes}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{Binding DtcText}" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding NewDtc}" Watermark="{l:T Ui_EGP0301}" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding AddDtcCommand}" ToolTip.Tip="{l:T Ui_Add}">
                      <l:LineIcon Data="{StaticResource Icon.plus}" />
                    </Button>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding ClearDtcsCommand}" ToolTip.Tip="{l:T Ui_Clear}">
                      <l:LineIcon Data="{StaticResource Icon.trash-2}" />
                    </Button>
                  </Grid>
                  <TextBlock Classes="small" Text="{l:T Ui_QuickAdd}" />
                  <ItemsControl ItemsSource="{Binding DtcToggles}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DtcToggleViewModel">
                        <ToggleButton Classes="chip" IsChecked="{Binding IsOn}" Content="{Binding Code, StringFormat='+ {0}'}" ToolTip.Tip="{Binding Description}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Virtuell OBD -->
              <Border Classes="card" Padding="18">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentSoft}">
                      <l:LineIcon Data="{StaticResource Icon.plug}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="h2" Text="{l:T Ui_VirtualOBD}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding ObdOn}" OnContent="" OffContent="" MinWidth="0" />
                  </Grid>
                  <TextBlock Text="{Binding ObdStatus}" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Classes="small" Text="{l:T Ui_AppearsAsAnOrdinaryWiFi}" />
                  <TextBlock Classes="small" Text="{Binding ObdClients}" />
                  <TextBlock Classes="small" Text="{Binding ObdLastAnswer}" />
                  <Border Classes="divider" />
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <l:LineIcon Data="{StaticResource Icon.bluetooth}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{l:T Ui_BluetoothOBDII}" VerticalAlignment="Center" FontWeight="Medium" />
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding BluetoothEnabled}" IsEnabled="{Binding BluetoothSupported}" OnContent="" OffContent="" MinWidth="0" />
                  </Grid>
                  <TextBlock Classes="small" Text="{Binding BluetoothStatus}" />
                  <TextBlock Classes="small" IsVisible="{Binding BluetoothEnabled}"
                             Text="{Binding BluetoothName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_AndroidPairing}" />
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <l:LineIcon Data="{StaticResource Icon.bluetooth}" Foreground="{StaticResource Purple}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{l:T Ui_BluetoothLEIPhone}" VerticalAlignment="Center" FontWeight="Medium" />
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding BleEnabled}" IsEnabled="{Binding BluetoothSupported}" OnContent="" OffContent="" MinWidth="0" />
                  </Grid>
                  <TextBlock Classes="small" Text="{Binding BleStatus}" />
                  <TextBlock Classes="small" IsVisible="{Binding BleEnabled}" Text="{l:T Ui_IPhoneNoPairingInTheIOS}" />
                </StackPanel>
              </Border>

              <!-- Dolda funktioner (genväg) -->
              <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="32" Height="32" CornerRadius="10" Background="#EFEFFD" VerticalAlignment="Top">
                    <l:LineIcon Data="{StaticResource Icon.key-round}" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="h3" Text="{l:T Ui_HiddenFeatures}" />
                    <TextBlock Classes="small" Text="{Binding FeatureOnText}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="plain" Content="{l:T Ui_Open}" Command="{Binding GoToPageCommand}" CommandParameter="1" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>

      <!-- ================= DOLDA FUNKTIONER ================= -->
      <DockPanel IsVisible="{Binding IsFeatures}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Classes="title" Text="{l:T Ui_HiddenFeatures}" />
            <TextBlock Classes="lead" Text="{l:T Ui_TurnOnOrOffAnOBD}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="plain" Command="{Binding ResetCodingCommand}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.rotate-ccw}" Size="16" /><TextBlock Text="{l:T Ui_ResetToFactory}" /></StackPanel>
          </Button>
        </Grid>
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
              <TextBlock Classes="muted" Text="{Binding CarInfo}" />
              <CheckBox IsChecked="{Binding RequireSecurityAccess}" Content="{l:T Ui_RequireSecurityKeyUDS27}" ToolTip.Tip="{l:T Ui_OnCodingWith2ERequires10}" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Features}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FeatureViewModel">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Width="36" Height="36" CornerRadius="10" Background="#EFEFFD" VerticalAlignment="Top">
                          <l:LineIcon Data="{StaticResource Icon.key-round}" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Classes="muted" Text="{Binding Description}" />
                          <TextBlock Classes="small" Text="{Binding Where}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsOn}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- ================= OBD-LOGG ================= -->
      <DockPanel IsVisible="{Binding IsLog}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Classes="title" Text="{l:T Ui_OBDLog}" />
            <TextBlock Classes="lead" Text="{l:T Ui_RequestFromTheAppReplyFrom}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="plain" Command="{Binding ClearLogCommand}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.trash-2}" Size="16" /><TextBlock Text="{l:T Ui_ClearTheLog}" /></StackPanel>
          </Button>
        </Grid>
        <Border Classes="card" Padding="12">
          <ListBox Classes="log" ItemsSource="{Binding Log}" FontSize="13" />
        </Border>
      </DockPanel>

      <!-- ================= ANDROID ================= -->
      <DockPanel IsVisible="{Binding IsAndroid}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Ui_Android}" />
          <TextBlock Classes="lead" Text="{l:T Lead_Android}" />
        </StackPanel>
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                  <l:LineIcon Data="{StaticResource Icon.smartphone}" Size="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding AndroidStatus}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                  <TextBlock Classes="small" Text="{Binding AndroidModeText}" />
                  <TextBlock Classes="small" Text="{l:T Ui_TheFirstInstallationDownloadsSeveralGB}" />
                  <TextBlock Classes="small" IsVisible="{Binding HasAndroidObdAddress}"
                             Text="{Binding AndroidObdAddress, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_ObdAddressEmulator}" />
                </StackPanel>
              </Grid>
              <Border Classes="note" IsVisible="{Binding TestAppHelpVisible}">
                <TextBlock Text="{Binding TestAppHelp}" TextWrapping="Wrap" FontSize="12" />
              </Border>
              <!-- Bekräftelse innan ett steg som kräver omstart -->
              <Border Classes="warnbox" IsVisible="{Binding ConfirmVisible}">
                <StackPanel Spacing="10">
                  <TextBlock Text="{l:T Ui_TheComputerNeedsToRestart}" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                  <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="{l:T Ui_Continue}" Command="{Binding ConfirmContinueCommand}" />
                    <Button Classes="plain" Content="{l:T Ui_Cancel}" Command="{Binding ConfirmCancelCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- Förlopp för installation/nedladdning (och orsaken när något stannar) -->
              <Border Classes="note" IsVisible="{Binding InstallProgressVisible}" Classes.done="{Binding InstallDone}">
                <Border.Styles>
                  <Style Selector="Border.done"><Setter Property="Background" Value="{StaticResource OkSoft}" /></Style>
                  <Style Selector="Border.done ProgressBar"><Setter Property="Foreground" Value="{StaticResource OkDot}" /></Style>
                </Border.Styles>
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding InstallProgressText}" FontWeight="Medium" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding InstallProgressPercentText}" FontWeight="SemiBold" Margin="12,0,0,0" />
                  </Grid>
                  <ProgressBar Minimum="0" Maximum="100" Height="8" CornerRadius="4"
                               Value="{Binding InstallProgressValue}" IsIndeterminate="{Binding InstallProgressIndeterminate}" />
                </StackPanel>
              </Border>
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <Button Classes="primary" Command="{Binding InstallAndroidCommand}" IsEnabled="{Binding AndroidCanInstall}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.download}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_InstallAndroid}" /></StackPanel>
                </Button>
                <!-- Android på/av: första platsen i verktygsraden, tydligt synlig -->
                <Border Classes="androidswitch" IsVisible="{Binding AndroidInstalled}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Android" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding AndroidOn}" IsEnabled="{Binding AndroidSwitchEnabled}" OnContent="" OffContent="" MinWidth="0" ToolTip.Tip="{Binding AndroidStatus}" />
                    <ProgressBar IsIndeterminate="True" Width="28" Height="4" MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding AndroidSwitching}" />
                    <TextBlock Classes="small" Text="{Binding AndroidSwitchText}" VerticalAlignment="Center" MinWidth="58" />
                  </StackPanel>
                </Border>
                                <Button Classes="plain" Command="{Binding OpenAndroidScreenCommand}" IsEnabled="{Binding AndroidRunning}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.monitor}" Size="16" /><TextBlock Text="{l:T Ui_ShowTheScreen}" /></StackPanel>
                </Button>
                <Button Classes="plain" Click="PickApk" IsEnabled="{Binding AndroidRunning}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.package}" Size="16" /><TextBlock Text="{l:T Ui_InstallAppAPK}" /></StackPanel>
                </Button>
                <Button Classes="plain" Content="{l:T Ui_InstallCyberdromeRadio}" Command="{Binding InstallRadioAppCommand}" IsEnabled="{Binding CanControlScreen}" />
                <Button Classes="plain" Content="{l:T Ui_InstallTestAppAndrOBD}" Command="{Binding InstallTestAppCommand}" IsEnabled="{Binding CanControlScreen}"
                        ToolTip.Tip="{l:T Ui_FreeOBDAppGPLv3FromF}" />
                <Button Classes="icon" Command="{Binding RefreshAndroidCommand}" ToolTip.Tip="{l:T Ui_CheckAgain}">
                  <l:LineIcon Data="{StaticResource Icon.refresh-cw}" />
                </Button>
              </WrapPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h3" Text="{l:T Ui_Log}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon" Command="{Binding ClearAndroidLogCommand}" ToolTip.Tip="{l:T Ui_Clear2}">
                  <l:LineIcon Data="{StaticResource Icon.trash-2}" />
                </Button>
              </Grid>
            </StackPanel>
            <ListBox Classes="log" ItemsSource="{Binding AndroidLog}" />
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- ================= KÖRNINGAR ================= -->
      <DockPanel IsVisible="{Binding IsDrives}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Ui_Drives}" />
          <TextBlock Classes="lead" Text="{l:T Ui_RecordWhileYouMoveTheSliders}" />
        </StackPanel>
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <TextBox Width="280" Text="{Binding RecordName}" Watermark="{l:T Ui_NameOfTheDrive}" IsEnabled="{Binding !IsRecording}" />
                <Button Classes="primary" Command="{Binding ToggleRecordCommand}" IsEnabled="{Binding CanRecord}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="10" Height="10" Fill="#FF453A" VerticalAlignment="Center" /><TextBlock Text="{Binding RecordButtonText}" /></StackPanel>
                </Button>
                <Button Classes="plain" Click="ImportDriveClick">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.upload}" Size="16" /><TextBlock Text="{l:T Ui_Import}" /></StackPanel>
                </Button>
              </WrapPanel>
              <TextBlock Classes="muted" Text="{Binding RecordStatus}" />
              <!-- Uppspelning -->
              <Border Classes="note" IsVisible="{Binding IsPlayingDrive}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding PlayingName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_PlayingDrive}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding DrivePositionText}" FontWeight="SemiBold" />
                  </Grid>
                  <Slider Minimum="0" Maximum="{Binding DriveDuration}" Value="{Binding DrivePosition}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="{Binding PlayButtonText}" Command="{Binding PlayPauseDriveCommand}" CommandParameter="{x:Null}" />
                    <Button Classes="plain" Content="{l:T Ui_Stop2}" Command="{Binding StopDriveCommand}" />
                    <ComboBox ItemsSource="{Binding DriveRates}" SelectedIndex="{Binding DriveRateIndex}" Width="90" />
                    <CheckBox Content="{l:T Ui_Loop}" IsChecked="{Binding DriveLoop}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding DriveMessage}" FontWeight="Medium" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DriveItemViewModel">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                          <l:LineIcon Data="{StaticResource Icon.route}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Classes="muted" Text="{Binding Description}" />
                          <TextBlock Classes="small" Text="{Binding Info}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="icon" Background="{StaticResource Accent}" ToolTip.Tip="{l:T Ui_Play}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PlayPauseDriveCommand}" CommandParameter="{Binding}">
                            <l:LineIcon Data="{StaticResource Icon.play}" Foreground="White" />
                          </Button>
                          <TextBox Width="170" Text="{Binding EditName}" />
                          <Button Classes="icon" ToolTip.Tip="{l:T Ui_Rename}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RenameDriveCommand}" CommandParameter="{Binding}">
                            <l:LineIcon Data="{StaticResource Icon.pencil}" />
                          </Button>
                          <Button Classes="icon" Click="ExportDriveClick" Tag="{Binding}" ToolTip.Tip="{l:T Ui_Export}">
                            <l:LineIcon Data="{StaticResource Icon.download}" />
                          </Button>
                          <Button Classes="icon" ToolTip.Tip="{l:T Ui_Delete}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDriveCommand}" CommandParameter="{Binding}">
                            <l:LineIcon Data="{StaticResource Icon.trash-2}" Foreground="{StaticResource Error}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- ================= KARTA ================= -->
      <DockPanel IsVisible="{Binding IsMap}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Ui_MapAndGPS}" />
          <TextBlock Classes="lead" Text="{l:T Lead_Map}" />
        </StackPanel>
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
              <TextBlock Classes="muted" Text="{Binding MapHelp}" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <ComboBox ItemsSource="{Binding MapClickModes}" SelectedIndex="{Binding MapClickMode}" Width="230" />
                <Button Classes="primary" Command="{Binding StartRouteCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.play}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_DriveTheRoute}" /></StackPanel>
                </Button>
                <Button Classes="plain" Command="{Binding ClearRouteCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.x}" Size="16" /><TextBlock Text="{l:T Ui_ClearRoute}" /></StackPanel>
                </Button>
                <Button Classes="plain" Command="{Binding InstallMapAppCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.package}" Size="16" /><TextBlock Text="{l:T Ui_InstallMapAppInAndroidOrganic}" /></StackPanel>
                </Button>
                <CheckBox Content="{l:T Ui_FollowTheCar}" IsChecked="{Binding FollowCar}" />
                <CheckBox Content="{l:T Ui_SendGPSToAndroid}" IsChecked="{Binding SendGpsToAndroid}" />
              </WrapPanel>
              <TextBlock Text="{Binding GpsStatus}" FontWeight="Medium" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="small" Text="{l:T Ui_MapTiles}" VerticalAlignment="Center" />
                <TextBox Width="420" Text="{Binding MapTileUrl}" FontSize="12" />
              </StackPanel>
              <TextBlock Classes="small" FontSize="11" Text="{l:T Ui_MapDataOpenStreetMapContributorsODbLOpenStreetMap}" />
            </StackPanel>
            <Border CornerRadius="14" ClipToBounds="True">
              <views:OsmMapControl x:Name="Map"
                                   CarPosition="{Binding CarPosition}" CarBearing="{Binding CarBearing}"
                                   Route="{Binding MapRoute}" FollowCar="{Binding FollowCar, Mode=TwoWay}"
                                   TileUrl="{Binding MapTileUrl}" />
            </Border>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- ================= TESTFALL ================= -->
      <DockPanel IsVisible="{Binding IsTests}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Ui_TestCases}" />
          <TextBlock Classes="lead" Text="{l:T Ui_RunATestCaseWhileThe}" />
        </StackPanel>
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <ComboBox ItemsSource="{Binding TestCases}" SelectedItem="{Binding SelectedTest}" Width="320" IsEnabled="{Binding CanRunTest}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="obdt:TestCase">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="primary" Command="{Binding RunTestCommand}" IsEnabled="{Binding CanRunTest}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.play}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_RunTheTest}" /></StackPanel>
                </Button>
                <Button Classes="plain" Content="{l:T Ui_Cancel2}" Command="{Binding StopTestCommand}" IsVisible="{Binding IsTestRunning}" />
                <Button Classes="plain" Click="ImportTestClick" IsEnabled="{Binding CanRunTest}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.upload}" Size="16" /><TextBlock Text="{l:T Ui_ImportTestCase}" /></StackPanel>
                </Button>
                <Button Classes="plain" Click="ExportTestClick">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.download}" Size="16" /><TextBlock Text="{l:T Ui_ExportAsTemplate}" /></StackPanel>
                </Button>
              </WrapPanel>
              <TextBlock Classes="muted" Text="{Binding SelectedTestInfo}" />
              <ProgressBar Minimum="0" Maximum="100" Height="6" CornerRadius="3" Value="{Binding TestProgress}" IsVisible="{Binding IsTestRunning}" />
              <TextBlock Text="{Binding TestInstruction}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TestSummary}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Foreground="{Binding TestSummaryColor}" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTestReport}">
                <Button Classes="plain" Command="{Binding OpenTestReportCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.file-text}" Size="16" /><TextBlock Text="{l:T Ui_OpenTheReport}" /></StackPanel>
                </Button>
                <Button Classes="plain" Command="{Binding OpenReportFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.folder-open}" Size="16" /><TextBlock Text="{l:T Ui_OpenTheReportsFolder}" /></StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding TestResultRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CheckRow">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,170">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" Text="{Binding Detail}" />
                          <SelectableTextBlock Classes="code" Text="{Binding Excerpt}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- ================= BILMODELLER ================= -->
      <DockPanel IsVisible="{Binding IsCars}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Ui_CarModels}" />
          <TextBlock Classes="lead" Text="{l:T Ui_TheSixBuiltInCarModels}" />
        </StackPanel>
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoft}">
                  <l:LineIcon Data="{StaticResource Icon.car}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding SelectedProfile.ListName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_Selected}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
              </StackPanel>
              <WrapPanel IsEnabled="{Binding !IsEditingCar}" ItemSpacing="8" LineSpacing="8">
                <Button Classes="primary" Command="{Binding NewCarFromCopyCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.plus}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_NewCarModelFromCopy}" /></StackPanel>
                </Button>
                <Button Classes="plain" Command="{Binding EditCarCommand}" IsEnabled="{Binding SelectedIsOwn}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.pencil}" Size="16" /><TextBlock Text="{l:T Ui_Edit}" /></StackPanel>
                </Button>
                <Button Classes="plain" Command="{Binding DeleteCarCommand}" IsEnabled="{Binding SelectedIsOwn}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.trash-2}" Size="16" /><TextBlock Text="{l:T Ui_Delete}" /></StackPanel>
                </Button>
                <Button Classes="plain" Click="ExportCarClick">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.download}" Size="16" /><TextBlock Text="{l:T Ui_ExportCarModel}" /></StackPanel>
                </Button>
                <Button Classes="plain" Click="ImportCarClick">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.upload}" Size="16" /><TextBlock Text="{l:T Ui_ImportCarModel}" /></StackPanel>
                </Button>
                <CheckBox x:Name="ExportWithCoding" IsChecked="True" Content="{l:T Ui_ExportWithCurrentCoding}" />
              </WrapPanel>
              <TextBlock Classes="small" Text="{l:T Ui_StandardFormatsASAMODX22}" />
              <WrapPanel IsEnabled="{Binding !IsEditingCar}" ItemSpacing="8" LineSpacing="8">
                <Button Classes="plain" Content="{l:T Ui_ExportODXPdx}" Click="ExportOdxClick" />
                <Button Classes="plain" Content="{l:T Ui_TroubleCodeTextsCSV}" Click="ImportDtcTextsClick" />
                <Button Classes="plain" Content="{l:T Ui_ImportPIDsCSV}" Click="ImportPidsClick" />
                <Button Classes="plain" Content="{l:T Ui_ExportPIDsCSV}" Click="ExportPidsClick" />
                <Button Classes="plain" Content="{l:T Ui_ImportSignalsOBDbJSON}" Click="ImportObdbJsonClick" />
                <Button Classes="plain" Content="{l:T Ui_ExportValuesVSS}" Click="ExportVssClick" />
                <Button Classes="plain" Content="{l:T Ui_ImportValuesVSS}" Click="ImportVssClick" />
              </WrapPanel>
              <TextBlock Text="{Binding CarStatus}" FontWeight="Medium" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Redigerare -->
            <ScrollViewer IsVisible="{Binding IsEditingCar}">
              <StackPanel DataContext="{Binding CarEditor}" x:DataType="vm:CarEditorViewModel" Spacing="10" Margin="0,0,12,0">
                <TextBlock Classes="h2" Text="{Binding Title}" />
                <Grid ColumnDefinitions="130,*,130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                  <TextBlock Text="{l:T Ui_Make}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Make}" />
                  <TextBlock Grid.Column="2" Text="{l:T Ui_Model}" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding Model}" />
                  <TextBlock Grid.Row="1" Text="{l:T Ui_Generation}" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Generation}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:T Ui_ModelYear}" VerticalAlignment="Center" /><NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding Year}" Minimum="1996" Maximum="2100" FormatString="0" />
                  <TextBlock Grid.Row="2" Text="{l:T Ui_Id}" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Id}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{l:T Ui_VIN17Characters}" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Vin}" FontFamily="{StaticResource MonoFont}" />
                  <TextBlock Grid.Row="3" Text="{l:T Ui_TroubleCodesAtStart}" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StartDtcs}" Watermark="{l:T Ui_EGP0300U0100}" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Text="{l:T Ui_PIDsHex}" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="3" Text="{Binding SupportedPids}" Watermark="{l:T Ui_EmptyAll}" />
                  <TextBlock Grid.Row="4" Text="{l:T Ui_ScreenPreset}" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ScreenPreset}" Watermark="{l:T Ui_EG10in1280x800}" />
                  <TextBlock Grid.Row="4" Grid.Column="2" Text="{l:T Ui_Theme}" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Theme}" Watermark="{l:T Ui_EGVwGolf8}" />
                  <TextBlock Grid.Row="5" Text="{l:T Ui_StartValues}" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                    <TextBox Width="90" Text="{Binding DefSpeed}" Watermark="km/h" />
                    <TextBox Width="90" Text="{Binding DefRpm}" Watermark="rpm" />
                    <TextBox Width="90" Text="{Binding DefCoolant}" Watermark="°C" />
                    <TextBox Width="90" Text="{Binding DefFuel}" Watermark="{l:T Ui_Fuel2}" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="small" Text="{Binding KnownPidsText}" />

                <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="h3" Text="{l:T Ui_ControlUnitsECU}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="plain" Command="{Binding AddEcuCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><l:LineIcon Data="{StaticResource Icon.plus}" Size="16" /><TextBlock Text="{l:T Ui_ControlUnit}" /></StackPanel>
                  </Button></Grid>
                <ItemsControl ItemsSource="{Binding Ecus}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EcuRow">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3">
                        <TextBox Width="100" Text="{Binding Key}" Watermark="{l:T Ui_Key}" />
                        <TextBox Width="190" Text="{Binding Name}" Watermark="{l:T Ui_Name}" />
                        <TextBox Width="64" Text="{Binding RequestId}" Watermark="{l:T Ui_Request}" />
                        <TextBox Width="64" Text="{Binding ResponseId}" Watermark="{l:T Ui_Response}" />
                        <TextBox Width="110" Text="{Binding Coding}" Watermark="{l:T Ui_CodingHex}" FontFamily="{StaticResource MonoFont}" />
                        <TextBox Width="70" Text="{Binding CodingDid}" Watermark="DID" />
                        <Button Classes="icon" Command="{Binding $parent[ItemsControl].((vm:CarEditorViewModel)DataContext).RemoveEcuCommand}" CommandParameter="{Binding}">
                          <l:LineIcon Data="{StaticResource Icon.x}" />
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="h3" Text="{l:T Ui_HiddenFeatures}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="plain" Command="{Binding AddFeatureCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><l:LineIcon Data="{StaticResource Icon.plus}" Size="16" /><TextBlock Text="{l:T Ui_Feature}" /></StackPanel>
                  </Button></Grid>
                <ItemsControl ItemsSource="{Binding Features}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FeatureRow">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3">
                        <TextBox Width="120" Text="{Binding Id}" Watermark="{l:T Ui_Id2}" />
                        <TextBox Width="200" Text="{Binding Name}" Watermark="{l:T Ui_Name}" />
                        <TextBox Width="100" Text="{Binding Ecu}" Watermark="{l:T Ui_ControlUnit2}" />
                        <NumericUpDown Width="110" Value="{Binding Byte}" Minimum="0" Maximum="3" FormatString="0" />
                        <NumericUpDown Width="110" Value="{Binding Bit}" Minimum="0" Maximum="7" FormatString="0" />
                        <TextBox Width="220" Text="{Binding Description}" Watermark="{l:T Ui_Description}" />
                        <Button Classes="icon" Command="{Binding $parent[ItemsControl].((vm:CarEditorViewModel)DataContext).RemoveFeatureCommand}" CommandParameter="{Binding}">
                          <l:LineIcon Data="{StaticResource Icon.x}" />
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Errors}" Foreground="{StaticResource Error}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,12">
                  <Button Classes="primary" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveCarCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.save}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_Save}" /></StackPanel>
                  </Button>
                  <Button Classes="plain" Content="{l:T Ui_Cancel}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelCarEditCommand}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- ================= OBD-KÄLLA ================= -->
      <DockPanel IsVisible="{Binding IsSource}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Ui_OBDSource}" />
          <TextBlock Classes="lead" Text="{l:T Ui_ChooseWhetherTheAppsInAndroid}" />
        </StackPanel>
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="0,0,8,0">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <Border Classes="seg">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="seg" GroupName="src" Content="{l:T Ui_VirtualCar}" IsChecked="{Binding !SourceIsReal}" />
                    <RadioButton Classes="seg" GroupName="src" Content="{l:T Ui_RealAdapterBridgeAppsToThe}" IsChecked="{Binding SourceIsReal}" IsEnabled="{Binding AdapterConnected}" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                  <l:LineIcon Data="{StaticResource Icon.plug}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                  <TextBlock Classes="h3" Text="{l:T Ui_Adapter}" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel IsEnabled="{Binding !AdapterConnected}" ItemSpacing="8" LineSpacing="8">
                  <ComboBox ItemsSource="{Binding AdapterKinds}" SelectedIndex="{Binding AdapterKindIndex}" Width="280" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsComKind}">
                    <ComboBox ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}" Width="120" />
                    <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}" Width="110" />
                    <Button Classes="icon" Command="{Binding RefreshComPortsCommand}" ToolTip.Tip="{l:T Ui_Refresh}">
                      <l:LineIcon Data="{StaticResource Icon.refresh-cw}" />
                    </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBtKind}">
                    <ComboBox ItemsSource="{Binding BtDevices}" SelectedItem="{Binding SelectedBtDevice}" Width="320">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="app:AdapterDevice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="plain" Command="{Binding ScanBluetoothCommand}" IsEnabled="{Binding !AdapterBusy}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.bluetooth}" Size="16" /><TextBlock Text="{l:T Ui_ScanBluetooth}" /></StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWifiKind}">
                    <TextBox Text="{Binding WifiHost}" Width="160" />
                    <TextBox Text="{Binding WifiPort}" Width="80" />
                  </StackPanel>
                </WrapPanel>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Classes="primary" Content="{Binding AdapterConnected, Converter={x:Static vm:Conv.ConnectText}}" Command="{Binding ConnectAdapterCommand}" IsEnabled="{Binding !AdapterBusy}" />
                  <Button Classes="plain" Content="{l:T Ui_IdentifyAdapter}" Command="{Binding IdentifyAdapterCommand}" IsEnabled="{Binding !AdapterBusy}" />
                  <Button Classes="plain" Content="{l:T Ui_ReadRealCar}" Command="{Binding ScanRealCarCommand}" IsEnabled="{Binding CanUseAdapter}" />
                  <Button Classes="plain" Content="{l:T Ui_CreateVirtualCarFromRealCar}" Command="{Binding CreateCarFromScanCommand}" IsEnabled="{Binding CanUseAdapter}" />
                  <CheckBox Content="{l:T Ui_HideVINSerialNumber}" IsChecked="{Binding HideVinSerial}" />
                  <CheckBox Content="{l:T Ui_ShowLiveValues}" IsChecked="{Binding LiveValues}" IsEnabled="{Binding AdapterConnected}" />
                </WrapPanel>
                <TextBlock Text="{Binding AdapterStatus}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LiveText}" FontSize="16" FontWeight="SemiBold" IsVisible="{Binding LiveValues}" />
                <TextBox Text="{Binding ScanText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" MinHeight="120" IsVisible="{Binding ScanText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
            <Border Classes="warnbox">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <l:LineIcon Data="{StaticResource Icon.triangle-alert}" Foreground="{StaticResource WarnDot}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="6">
                  <CheckBox Content="{l:T Ui_AllowWritingForThisSession}" IsChecked="{Binding AllowWrites}" IsEnabled="{Binding AdapterConnected}" FontWeight="SemiBold" />
                  <TextBlock TextWrapping="Wrap" FontSize="12" Text="{l:T Ui_WarningWritingCanChangeOrDamage}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- ================= BILDATABAS ================= -->
      <DockPanel IsVisible="{Binding IsCarDb}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Ui_CarDatabase}" />
          <TextBlock Classes="lead" Text="{l:T Ui_SearchCarModelsAndDecodeVINs}" />
        </StackPanel>
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
              <WrapPanel IsEnabled="{Binding CanUseCarDb}" ItemSpacing="8" LineSpacing="8">
                <TextBox Text="{Binding CarDbQuery}" Watermark="{l:T Ui_SearchEGToyotaRav4}" Width="260" />
                <TextBox Text="{Binding CarDbYear}" Watermark="{l:T Ui_Year}" Width="80" />
                <Button Classes="primary" Command="{Binding SearchCarDbCommand}" IsDefault="True">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.search}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_Search}" /></StackPanel>
                </Button>
                <TextBox Text="{Binding CarDbVin}" Watermark="{l:T Ui_VIN17Characters}" Width="220" FontFamily="{StaticResource MonoFont}" />
                <Button Classes="plain" Content="{l:T Ui_DecodeVIN}" Command="{Binding DecodeVinCommand}" />
              </WrapPanel>
              <WrapPanel IsEnabled="{Binding CanUseCarDb}" ItemSpacing="8" LineSpacing="8">
                <Button Classes="plain" Content="{l:T Ui_GetMakesVPIC}" Command="{Binding FetchCarMakesCommand}" />
                <TextBox Text="{Binding CarDbMake}" Watermark="{l:T Ui_Make}" Width="140" />
                <TextBox Text="{Binding CarDbFrom}" Width="70" />
                <TextBlock Text="–" VerticalAlignment="Center" />
                <TextBox Text="{Binding CarDbTo}" Width="70" />
                <Button Classes="plain" Content="{l:T Ui_GetModelsVPIC}" Command="{Binding FetchCarModelsCommand}" />
                <Button Classes="plain" Content="{l:T Ui_GetModelsWikidata}" Command="{Binding FetchWikidataCommand}" />
                <Button Classes="plain" Content="{l:T Ui_GetVehicleListOBDb}" Command="{Binding FetchObdbListCommand}" />
              </WrapPanel>
              <Border Classes="note">
                <StackPanel Spacing="8">
                  <TextBlock Text="{l:T Ui_CanTFindTheModelCreate}" TextWrapping="Wrap" FontWeight="Medium" />
                  <WrapPanel IsEnabled="{Binding CanUseCarDb}" ItemSpacing="8" LineSpacing="8">
                    <TextBox Text="{Binding StdMake}" Watermark="{l:T Ui_Make}" Width="140" Background="White" />
                    <TextBox Text="{Binding StdModel}" Watermark="{l:T Ui_Model}" Width="160" Background="White" />
                    <TextBox Text="{Binding StdYear}" Watermark="{l:T Ui_Year}" Width="80" Background="White" />
                    <Button Classes="plain" Background="White" Content="{l:T Ui_CreateStandardOBDCar}" Command="{Binding CreateStandardCarCommand}" />
                    <Button Classes="plain" Background="White" Content="{l:T Ui_AddSignalsCarModels}" Command="{Binding GoToCarsCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding CarDbStatus}" FontWeight="Medium" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
              <WrapPanel ItemSpacing="8">
                <Button Classes="primary" Command="{Binding CreateCarFromDbCommand}" IsEnabled="{Binding HasCarDbHit}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.plus}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_CreateCarModel}" /></StackPanel>
                </Button>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:T Ui_MakeYourOwnCarModelWith}" />
              </WrapPanel>
              <TextBlock Classes="small" FontSize="11" Text="{Binding ObdbAttribution, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_CarDbSources}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <ListBox ItemsSource="{Binding CarDbHits}" SelectedItem="{Binding SelectedCarDbHit}" Background="{StaticResource Tile}" CornerRadius="12">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="cardb:CarDbHit"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBox Grid.Column="1" Text="{Binding CarDbDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="12" />
            </Grid>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- ================= INSTÄLLNINGAR ================= -->
      <!-- Ryms på en skärm i 1600x1000; går att rulla när fönstret är mindre. -->
      <DockPanel IsVisible="{Binding IsSettings}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Classes="title" Text="{l:T Ui_Settings}" />
          <TextBlock Classes="lead" Text="{l:T Lead_Settings}" />
        </StackPanel>
        <ScrollViewer x:Name="SettingsScroll">
          <StackPanel Spacing="16" Margin="0,0,8,4">
            <!-- Android-läge: tre valbara rutor -->
            <Border Classes="card">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <l:LineIcon Data="{StaticResource Icon.smartphone}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                  <TextBlock Classes="h2" Text="{l:T Ui_AndroidMode}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted" Text="{l:T Ui_ChooseHowAndroidRunsItCannot}" />
                <UniformGrid Columns="3" IsEnabled="{Binding CanChangeMode}">
                  <RadioButton Classes="tile" GroupName="AndroidMode" IsChecked="{Binding ModeNoRestart}" Margin="0,0,6,0">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                        <l:LineIcon Data="{StaticResource Icon.zap}" Size="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <l:LineIcon Grid.Column="1" Data="{StaticResource Icon.circle-check}" Foreground="{StaticResource Accent}" Size="20" VerticalAlignment="Top" IsVisible="{Binding ModeNoRestart}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="h3" FontSize="15" Margin="0,10,0,2" Text="{l:T Settings_ModeQuick}" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="small" Text="{l:T Settings_ModeQuickDesc}" ToolTip.Tip="{l:T Ui_RunsGoogleSAndroidAutomotiveEmulator}" />
                      <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                        <Ellipse Classes="dot" Fill="{Binding ModeStatusNoRestart.Brush}" />
                        <TextBlock Classes="small" Text="{Binding ModeStatusNoRestart.Text}" VerticalAlignment="Center" />
                        <Button Classes="link" FontSize="12" Content="{l:T Settings_ShowHow}" Command="{Binding GoToPageCommand}" CommandParameter="3" IsVisible="{Binding ModeStatusNoRestart.Problem}" />
                      </StackPanel>
                    </Grid>
                  </RadioButton>
                  <RadioButton Classes="tile" GroupName="AndroidMode" IsChecked="{Binding ModeGoogle}" Margin="3,0,3,0">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <Border Width="40" Height="40" CornerRadius="12" Background="#E8F7EE" HorizontalAlignment="Left">
                        <l:LineIcon Data="{StaticResource Icon.package}" Size="20" Foreground="#1E8E4A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <l:LineIcon Grid.Column="1" Data="{StaticResource Icon.circle-check}" Foreground="{StaticResource Accent}" Size="20" VerticalAlignment="Top" IsVisible="{Binding ModeGoogle}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="h3" FontSize="15" Margin="0,10,0,2" Text="{l:T Settings_ModeGoogle}" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="small" Text="{l:T Settings_ModeGoogleDesc}" ToolTip.Tip="{l:T Ui_LikeTheModeAboveButWith}" />
                      <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                        <Ellipse Classes="dot" Fill="{Binding ModeStatusGoogle.Brush}" />
                        <TextBlock Classes="small" Text="{Binding ModeStatusGoogle.Text}" VerticalAlignment="Center" />
                        <Button Classes="link" FontSize="12" Content="{l:T Settings_ShowHow}" Command="{Binding GoToPageCommand}" CommandParameter="3" IsVisible="{Binding ModeStatusGoogle.Problem}" />
                      </StackPanel>
                    </Grid>
                  </RadioButton>
                  <RadioButton Classes="tile" GroupName="AndroidMode" IsChecked="{Binding ModeFast}" Margin="6,0,0,0">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <Border Width="40" Height="40" CornerRadius="12" Background="#EFEFFD" HorizontalAlignment="Left">
                        <l:LineIcon Data="{StaticResource Icon.cpu}" Size="20" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <l:LineIcon Grid.Column="1" Data="{StaticResource Icon.circle-check}" Foreground="{StaticResource Accent}" Size="20" VerticalAlignment="Top" IsVisible="{Binding ModeFast}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="h3" FontSize="15" Margin="0,10,0,2" Text="{l:T Settings_ModeFast}" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="small" Text="{l:T Settings_ModeFastDesc}" ToolTip.Tip="{l:T Ui_RequiresARestartOfTheComputer}" />
                      <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                        <Ellipse Classes="dot" Fill="{Binding ModeStatusFast.Brush}" />
                        <TextBlock Classes="small" Text="{Binding ModeStatusFast.Text}" VerticalAlignment="Center" />
                        <Button Classes="link" FontSize="12" Content="{l:T Settings_ShowHow}" Command="{Binding GoToPageCommand}" CommandParameter="3" IsVisible="{Binding ModeStatusFast.Problem}" />
                      </StackPanel>
                    </Grid>
                  </RadioButton>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- Två kolumner med kort -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
              <!-- Skärm -->
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <l:LineIcon Data="{StaticResource Icon.monitor}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Classes="h2" Text="{l:T Ui_Screen}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="small" Text="{l:T Ui_SizeAndResolutionOfTheCar}" />
                  <WrapPanel ItemSpacing="10" LineSpacing="8">
                    <ComboBox ItemsSource="{Binding ScreenPresetList}" SelectedItem="{Binding SelectedScreenPreset}" Width="260" />
                    <Border Classes="seg">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg" GroupName="ScreenOrientation" Content="{l:T Ui_Landscape}" IsChecked="{Binding ScreenLandscape}" />
                        <RadioButton Classes="seg" GroupName="ScreenOrientation" Content="{l:T Ui_Portrait}" IsChecked="{Binding ScreenPortrait}" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                  <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsCustomScreen}">
                    <TextBlock Text="{l:T Ui_Width}" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding CustomScreenWidth}" Minimum="320" Maximum="4096" Increment="8" FormatString="0" Width="120" />
                    <TextBlock Text="{l:T Ui_Height}" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding CustomScreenHeight}" Minimum="320" Maximum="4096" Increment="8" FormatString="0" Width="120" />
                    <TextBlock Text="dpi" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding CustomScreenDpi}" Minimum="80" Maximum="640" Increment="1" FormatString="0" Width="100" />
                    <Button Classes="primary" Content="{l:T Ui_Apply}" Command="{Binding ApplyCustomScreenCommand}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding ScreenLabel}" FontWeight="Medium" />
                  <TextBlock Classes="small" Text="{Binding ScreenStatus}" />
                </StackPanel>
              </Border>

              <!-- Utseende per bilmodell -->
              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <l:LineIcon Data="{StaticResource Icon.palette}" Foreground="{StaticResource Pink}" VerticalAlignment="Center" />
                    <TextBlock Classes="h2" Text="{l:T Ui_LookPerCarModel}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="small" Text="{l:T Ui_ThemeTheHomeScreenInsideAndroid}" />
                  <Grid ColumnDefinitions="60,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <TextBlock Text="{l:T Ui_Theme2}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" HorizontalAlignment="Stretch" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                      <Button Classes="icon" Click="ImportThemeClick" ToolTip.Tip="{l:T Ui_UploadYourOwnTheme}"><l:LineIcon Data="{StaticResource Icon.upload}" /></Button>
                      <Button Classes="icon" Command="{Binding ReapplyLookCommand}" ToolTip.Tip="{l:T Ui_ApplyAgain}"><l:LineIcon Data="{StaticResource Icon.refresh-cw}" /></Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{l:T Ui_Skin}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding SelectedSkinOption}" HorizontalAlignment="Stretch" />
                    <Button Grid.Row="1" Grid.Column="2" Classes="icon" Click="ImportSkinClick" ToolTip.Tip="{l:T Ui_UploadYourOwnSkin}" HorizontalAlignment="Left"><l:LineIcon Data="{StaticResource Icon.upload}" /></Button>
                  </Grid>
                  <TextBlock Classes="small" Text="{Binding LookStatus}" />
                </StackPanel>
              </Border>

              <!-- Språk -->
              <Border Grid.Row="1" Classes="card">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <l:LineIcon Data="{StaticResource Icon.list}" Foreground="#1E8E4A" VerticalAlignment="Center" />
                    <TextBlock Classes="h2" Text="{l:T Settings_Language}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="small" Text="{l:T Settings_LanguageHelp}" />
                  <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" Width="260" />
                </StackPanel>
              </Border>

              <!-- Uppdateringar -->
              <Border Grid.Row="1" Grid.Column="1" Classes="card">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <l:LineIcon Data="{StaticResource Icon.download}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Classes="h2" Text="{l:T Ui_Updates}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="small" Text="{Binding UpdateSourceText}" />
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Button Classes="plain" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !UpdateBusy}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.refresh-cw}" Size="16" /><TextBlock Text="{l:T Ui_CheckForUpdates}" /></StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding !UpdateBusy}" IsVisible="{Binding UpdateAvailable}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><l:LineIcon Data="{StaticResource Icon.download}" Foreground="White" Size="16" /><TextBlock Text="{l:T Ui_InstallUpdate}" /></StackPanel>
                    </Button>
                  </WrapPanel>
                  <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontWeight="Medium" />
                  <ProgressBar Minimum="0" Maximum="100" Height="6" CornerRadius="3" Value="{Binding UpdateProgress}" IsVisible="{Binding UpdateDownloading}" />
                  <Border Classes="tile" IsVisible="{Binding UpdateAvailable}" MaxHeight="160">
                    <ScrollViewer>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="h3" Text="{l:T Release_WhatsNew}" />
                        <SelectableTextBlock Text="{Binding UpdateNotes}" TextWrapping="Wrap" FontSize="12" />
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                  <Expander Header="{l:T Settings_Advanced}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                      <CheckBox Content="{l:T Settings_AutoCheckUpdates}" IsChecked="{Binding AutoCheckUpdates}" />
                      <CheckBox Content="{l:T Settings_IncludePrereleases}" IsChecked="{Binding IncludePrereleases}" />
                      <CheckBox Content="{l:T Settings_UseLocalFolder}" IsChecked="{Binding UseLocalUpdateFolder}" />
                      <TextBox Text="{Binding UpdateFolder}" IsEnabled="{Binding UseLocalUpdateFolder}" ToolTip.Tip="{l:T Ui_FolderWithUpdatePackagesVelopackNo}" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
