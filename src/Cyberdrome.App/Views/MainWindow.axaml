<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cyberdrome.App.ViewModels"
        xmlns:p="using:Cyberdrome.Core.Profiles"
        xmlns:avm="using:Cyberdrome.Vm"
        xmlns:views="using:Cyberdrome.App.Views"
        xmlns:obdt="using:Cyberdrome.Obd.Testing"
        xmlns:app="using:Cyberdrome.App"
        xmlns:cardb="using:Cyberdrome.Core.CarDb"
        x:Class="Cyberdrome.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cyberdrome Simulator"
        Icon="/Assets/cyberdrome.ico"
        Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!-- Toppfält -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Accent}">
            <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Cyberdrome Simulator" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding VersionText}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="40,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Bilmodell:" Classes="muted" VerticalAlignment="Center" FontSize="14" />
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="280" CornerRadius="10">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="p:CarProfile">
                <TextBlock Text="{Binding ListName}" FontWeight="Medium" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <Border Classes="pill" Classes.off="{Binding !Ignition}" Padding="12,7">
            <TextBlock Text="{Binding CarRunningText}" FontSize="13" />
          </Border>
          <Button Classes="plain" Content="Om" Click="AboutClick" />
          <Button Classes="plain" Content="Licens" Click="LicenseClick" />
          <Button Classes="primary" Content="Starta Android" Command="{Binding StartAndroidCommand}" IsVisible="{Binding AndroidReady}" />
          <Button Classes="primary" Content="Installera Android" Command="{Binding InstallAndroidCommand}" IsVisible="{Binding AndroidCanInstall}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Statusrad -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
      <StackPanel Orientation="Horizontal" Spacing="24">
        <TextBlock Classes="muted" Text="{Binding AndroidStatusShort, StringFormat='● {0}'}" />
        <TextBlock Classes="muted" Text="{Binding ObdStatus, StringFormat='● {0}'}" />
        <TextBlock Classes="muted" Text="{Binding SelectedProfile.DisplayName, StringFormat='● Bilmodell: {0}'}" />
      </StackPanel>
    </Border>

    <!-- Sidomeny -->
    <Border DockPanel.Dock="Left" Width="230" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,18">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="12"
                   Text="Alla bilmodeller och kodningsdata är påhittade exempel för test." />
        <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedIndex="{Binding PageIndex}" />
      </DockPanel>
    </Border>

    <!-- Innehåll -->
    <Grid Margin="22">
      <Border Classes="card" IsVisible="{Binding HasError}" Background="{StaticResource WarnSoft}" VerticalAlignment="Top">
        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
      </Border>

      <!-- ÖVERSIKT -->
      <Grid ColumnDefinitions="*,380" ColumnSpacing="20" IsVisible="{Binding IsOverview}">
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4">
              <TextBlock Classes="h2" Text="Android i bilen" />
              <TextBlock Classes="muted" Text="Här visas bilens skärm när Android körs. Klicka och dra direkt på skärmen." />
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <ComboBox ItemsSource="{Binding ScreenPresetList}" SelectedItem="{Binding SelectedScreenPreset}" Width="290" />
                <RadioButton GroupName="ScreenOrientationQuick" Content="Liggande" IsChecked="{Binding ScreenLandscape}" />
                <RadioButton GroupName="ScreenOrientationQuick" Content="Stående" IsChecked="{Binding ScreenPortrait}" />
                <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding ScreenLabel}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <TextBlock Text="Tema i Android:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" Width="300" />
                <TextBlock Text="Skal:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding SelectedSkinOption}" Width="270" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding LookStatus}" />
            </StackPanel>
            <!-- Knappar under skärmen (emulatorläget, Android igång) -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
              <WrapPanel Orientation="Horizontal" IsVisible="{Binding CanControlScreen}">
                <Button Classes="primary" Margin="0,0,8,8" Content="+ Installera app" Click="PickApk" />
                <Button Classes="plain" Margin="0,0,8,8" Content="Installera Cyberdrome Radio" Command="{Binding InstallRadioAppCommand}"
                        ToolTip.Tip="Vår exempelapp: radio, rattknappar, live OBD och volym efter fart. Byggs från android\CyberdromeRadio." />
                <Button Classes="plain" Margin="0,0,8,8" Content="Installera testapp (AndrOBD)" Command="{Binding InstallTestAppCommand}"
                        ToolTip.Tip="Gratis OBD-app (GPLv3) från F-Droid. Laddas ner när du trycker – följer inte med Cyberdrome." />
                <Button Classes="plain" Margin="0,0,8,8" Content="Installera kartapp (Organic Maps)" Command="{Binding InstallMapAppCommand}"
                        ToolTip.Tip="Fri kartapp (Apache-2.0) från F-Droid, ca 63 MB. Visar GPS:en från Cyberdrome. Följer inte med Cyberdrome." />
                <Button Classes="plain" Margin="0,0,8,8" Content="Starta om app" Command="{Binding RestartForegroundAppCommand}" />
                <Button Classes="plain" Margin="0,0,16,8" Content="Ta skärmbild" Command="{Binding TakeScreenshotCommand}" />
                <TextBlock Classes="muted" Text="Rattknappar:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <Button Classes="plain" Margin="0,0,6,8" Content="⏮ Föregående" ToolTip.Tip="KEYCODE_MEDIA_PREVIOUS"
                        Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Previous}" />
                <Button Classes="plain" Margin="0,0,6,8" Content="Nästa ⏭" ToolTip.Tip="KEYCODE_MEDIA_NEXT"
                        Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Next}" />
                <Button Classes="plain" Margin="0,0,6,8" Content="🔇 Ljud av" ToolTip.Tip="KEYCODE_VOLUME_MUTE"
                        Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Mute}" />
              </WrapPanel>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding ScreenshotStatus}" IsVisible="{Binding CanControlScreen}" TextWrapping="Wrap" />
              <Border CornerRadius="10" Padding="12,10" Background="{StaticResource AccentSoft}" IsVisible="{Binding TestAppHelpVisible}">
                <TextBlock Text="{Binding TestAppHelp}" TextWrapping="Wrap" FontSize="12" />
              </Border>
              <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding HasScreenFrame}" TextWrapping="Wrap"
                         Text="{Binding AndroidObdAddress, StringFormat='OBD för appar i Android: {0}'}" />
            </StackPanel>
            <views:SkinHost x:Name="SkinFrame" Margin="0,16,0,0" Skin="{Binding ActiveSkin}">
              <Grid>
              <!-- Den levande Android-skärmen -->
              <Image x:Name="AndroidScreen" Source="{Binding ScreenFrame}" Stretch="Uniform" Cursor="Hand"
                     IsVisible="{Binding HasScreenFrame}"
                     PointerPressed="ScreenPointerPressed" PointerReleased="ScreenPointerReleased" />
              <Border CornerRadius="10" Background="#F1F5F9" IsVisible="{Binding ShowScreenPlaceholder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="460">
                  <TextBlock Text="{Binding AndroidStatusShort}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Classes="muted" TextAlignment="Center" Text="{Binding AndroidStatus}" />
                  <StackPanel Spacing="6" IsVisible="{Binding InstallProgressVisible}" MinWidth="320">
                    <ProgressBar Minimum="0" Maximum="100" Height="8" CornerRadius="4"
                                 Value="{Binding InstallProgressValue}" IsIndeterminate="{Binding InstallProgressIndeterminate}" />
                    <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                               Text="{Binding InstallProgressText}" />
                  </StackPanel>
                  <TextBlock Classes="muted" TextAlignment="Center"
                             Text="Redan nu kan du testa OBD: anslut en OBD-app (t.ex. i en Android-telefon på samma nätverk) till adressen nedan som en Wi-Fi-dongel." />
                  <Button Classes="primary" HorizontalAlignment="Center" Content="Visa Android-skärmen" Command="{Binding OpenAndroidScreenCommand}" IsVisible="{Binding AndroidRunning}" />
                  <Border CornerRadius="10" Background="White" Padding="14,10" HorizontalAlignment="Center">
                    <SelectableTextBlock Text="{Binding ObdAddress}" FontFamily="Consolas,Menlo,monospace" FontSize="15" />
                  </Border>
                  <StackPanel Spacing="4" IsVisible="{Binding HasAndroidObdAddress}" HorizontalAlignment="Center">
                    <TextBlock Classes="muted" TextAlignment="Center" Text="OBD-adress för appar inne i Android-emulatorn:" />
                    <Border CornerRadius="10" Background="White" Padding="14,10" HorizontalAlignment="Center">
                      <SelectableTextBlock Text="{Binding AndroidObdAddress}" FontFamily="Consolas,Menlo,monospace" FontSize="15" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                </ScrollViewer>
              </Border>
              </Grid>
            </views:SkinHost>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
          <StackPanel Spacing="16">
            <!-- Bilen just nu -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Bilen just nu" />
                <TextBlock Classes="muted" Text="Dra för att ändra. Android och OBD ser samma värden." />
                <Border CornerRadius="8" Padding="10,6" Background="{StaticResource WarnSoft}" IsVisible="{Binding IsPlayingDrive}">
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontWeight="SemiBold" Text="{Binding PlayingName, StringFormat='Uppspelning pågår: {0} – reglagen följer körningen (stoppa under Körningar)'}" />
                </Border>
                <Grid ColumnDefinitions="90,*,70" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2" IsEnabled="{Binding ManualControl}">
                  <TextBlock Text="Hastighet" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="250" Value="{Binding Speed}" />
                  <TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat='{}{0:0} km/h'}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="1" Text="Varvtal" VerticalAlignment="Center" />
                  <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="7000" Value="{Binding Rpm}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Rpm, StringFormat='{}{0:0}'}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="2" Text="Kylvätska" VerticalAlignment="Center" />
                  <Slider Grid.Row="2" Grid.Column="1" Minimum="-20" Maximum="130" Value="{Binding Coolant}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Coolant, StringFormat='{}{0:0} °C'}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="3" Text="Bränsle" VerticalAlignment="Center" />
                  <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Fuel}" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Fuel, StringFormat='{}{0:0} %'}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding ManualControl}">
                  <TextBlock Text="Växel" Width="84" VerticalAlignment="Center" />
                  <RadioButton GroupName="gear" Content="P" IsChecked="{Binding GearP}" />
                  <RadioButton GroupName="gear" Content="R" IsChecked="{Binding GearR}" />
                  <RadioButton GroupName="gear" Content="N" IsChecked="{Binding GearN}" />
                  <RadioButton GroupName="gear" Content="D" IsChecked="{Binding GearD}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20" IsEnabled="{Binding ManualControl}">
                  <ToggleSwitch IsChecked="{Binding Ignition}" OnContent="Tändning" OffContent="Tändning" />
                  <ToggleSwitch IsChecked="{Binding Dark}" OnContent="Mörker" OffContent="Mörker" />
                </StackPanel>
                <Separator />
                <TextBlock Text="Felkoder" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding DtcText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding NewDtc}" Watermark="t.ex. P0301" Width="120" />
                  <Button Classes="plain" Content="Lägg till" Command="{Binding AddDtcCommand}" />
                  <Button Classes="plain" Content="Rensa" Command="{Binding ClearDtcsCommand}" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="12" Text="Snabbval – vanliga felkoder:" />
                <ItemsControl ItemsSource="{Binding DtcToggles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DtcToggleViewModel">
                      <CheckBox IsChecked="{Binding IsOn}" Content="{Binding Label}" FontSize="12" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- OBD -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="Virtuell OBD" />
                  <Border Grid.Column="1" Classes="pill" Classes.off="{Binding !ObdRunning}">
                    <TextBlock Text="{Binding ObdRunning, Converter={x:Static vm:Conv.OnOff}}" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding ObdStatus}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="Syns som en vanlig Wi-Fi OBD-dongel (ELM327)." />
                <TextBlock Text="{Binding ObdClients}" FontWeight="Medium" />
                <TextBlock Classes="muted" Text="{Binding ObdLastAnswer}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="plain" Content="Starta" Command="{Binding StartObdCommand}" IsEnabled="{Binding !ObdRunning}" />
                  <Button Classes="plain" Content="Stoppa" Command="{Binding StopObdCommand}" IsEnabled="{Binding ObdRunning}" />
                </StackPanel>
                <!-- Bluetooth -->
                <Border Height="1" Background="{StaticResource Line}" Margin="0,4" />
                <ToggleSwitch IsChecked="{Binding BluetoothEnabled}" IsEnabled="{Binding BluetoothSupported}"
                              Content="Bluetooth (OBDII)" OnContent="På" OffContent="Av" />
                <TextBlock Text="{Binding BluetoothStatus}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding BluetoothEnabled}"
                           Text="{Binding BluetoothName, StringFormat='Android: para telefonen med datorn ”{0}” i telefonens Bluetooth-inställningar. Välj sedan Bluetooth-adapter i OBD-appen och datorn ”{0}” (tjänsten OBDII).'}" />
                <ToggleSwitch IsChecked="{Binding BleEnabled}" IsEnabled="{Binding BluetoothSupported}"
                              Content="Bluetooth LE (iPhone)" OnContent="På" OffContent="Av" />
                <TextBlock Text="{Binding BleStatus}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding BleEnabled}"
                           Text="iPhone: ingen parning i iOS-inställningar behövs. Öppna OBD-appen (t.ex. Car Scanner), välj adaptertyp Bluetooth LE / BLE, sök och välj datorn i listan." />
              </StackPanel>
            </Border>

            <!-- Dolda funktioner kort -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Dolda funktioner" />
                <TextBlock Classes="muted" Text="{Binding FeatureSummary}" />
                <Grid ColumnDefinitions="*,Auto">
                  <Border Classes="pill"><TextBlock Text="{Binding FeatureOnText}" /></Border>
                  <Button Grid.Column="1" Classes="plain" Content="Öppna" Click="OpenFeatures" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- DOLDA FUNKTIONER -->
      <Border Classes="card" IsVisible="{Binding IsFeatures}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="Dolda funktioner" />
              <TextBlock Classes="muted" Text="Slå på eller av. En OBD-app som kodar bilen ser samma ändringar (UDS 22/2E)." />
              <TextBlock Classes="muted" Text="{Binding CarInfo}" />
              <CheckBox Margin="0,6,0,0" IsChecked="{Binding RequireSecurityAccess}"
                        Content="Kräv säkerhetsnyckel (UDS 27)"
                        ToolTip.Tip="På: kodning med 2E kräver 10 03 och upplåsning med 27 01 / 27 02. Den förväntade nyckeln visas i OBD-loggen. Formeln är påhittad och gäller bara de simulerade styrdonen." />
            </StackPanel>
            <Button Grid.Column="1" Classes="plain" Content="Återställ till fabrik" Command="{Binding ResetCodingCommand}" VerticalAlignment="Top" />
          </Grid>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Features}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FeatureViewModel">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Classes="muted" Text="{Binding Description}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Where}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" OnContent="På" OffContent="Av" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- OBD-LOGG -->
      <Border Classes="card" IsVisible="{Binding IsLog}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="OBD-logg" />
              <TextBlock Classes="muted" Text="→ fråga från appen   ← svar från den virtuella bilen" />
            </StackPanel>
            <Button Grid.Column="1" Classes="plain" Content="Töm loggen" Command="{Binding ClearLogCommand}" />
          </Grid>
          <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas,Menlo,monospace" FontSize="13" Background="#F8FAFC" />
        </DockPanel>
      </Border>

      <!-- ANDROID -->
      <Border Classes="card" IsVisible="{Binding IsAndroid}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Classes="h2" Text="Android" />
            <TextBlock Text="{Binding AndroidStatus}" FontWeight="Medium" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding AndroidModeText}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Första installationen laddar ner flera GB och kan ta en stund. Läget väljs under Inställningar." />
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasAndroidObdAddress}"
                       Text="{Binding AndroidObdAddress, StringFormat='OBD-adress inne i emulatorn: {0}  ·  Googles emulatoravbilder får inte följa med i den sålda produkten.'}" />
            <Border CornerRadius="10" Padding="12,10" Background="{StaticResource AccentSoft}" IsVisible="{Binding TestAppHelpVisible}">
              <TextBlock Text="{Binding TestAppHelp}" TextWrapping="Wrap" FontSize="12" />
            </Border>
            <!-- Bekräftelse innan ett steg som kräver omstart -->
            <Border CornerRadius="10" Padding="14,12" IsVisible="{Binding ConfirmVisible}" Background="{StaticResource WarnSoft}">
              <StackPanel Spacing="10">
                <TextBlock Text="En omstart av datorn behövs" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Fortsätt" Command="{Binding ConfirmContinueCommand}" />
                  <Button Classes="plain" Content="Avbryt" Command="{Binding ConfirmCancelCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- Förloppsstapel för installation/nedladdning -->
            <Border CornerRadius="10" Padding="14,12" IsVisible="{Binding InstallProgressVisible}"
                    Background="{StaticResource AccentSoft}" Classes.done="{Binding InstallDone}">
              <Border.Styles>
                <Style Selector="Border.done"><Setter Property="Background" Value="{StaticResource OkSoft}" /></Style>
                <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>
                <Style Selector="Border.done ProgressBar"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
              </Border.Styles>
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding InstallProgressText}" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding InstallProgressPercentText}" FontWeight="SemiBold" Margin="12,0,0,0" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Height="10" CornerRadius="5"
                             Value="{Binding InstallProgressValue}" IsIndeterminate="{Binding InstallProgressIndeterminate}" />
              </StackPanel>
            </Border>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary" Margin="0,0,8,8" Content="Installera Android" Command="{Binding InstallAndroidCommand}" IsEnabled="{Binding AndroidCanInstall}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Starta" Command="{Binding StartAndroidCommand}" IsEnabled="{Binding AndroidReady}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Stoppa" Command="{Binding StopAndroidCommand}" IsEnabled="{Binding AndroidRunning}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Visa skärmen" Command="{Binding OpenAndroidScreenCommand}" IsEnabled="{Binding AndroidRunning}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Installera app (APK)" Click="PickApk" IsEnabled="{Binding AndroidRunning}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Installera Cyberdrome Radio" Command="{Binding InstallRadioAppCommand}" IsEnabled="{Binding CanControlScreen}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Installera testapp (AndrOBD)" Command="{Binding InstallTestAppCommand}" IsEnabled="{Binding CanControlScreen}"
                      ToolTip.Tip="Gratis OBD-app (GPLv3) från F-Droid. Laddas ner när du trycker – följer inte med Cyberdrome." />
              <Button Classes="plain" Margin="0,0,8,8" Content="Kontrollera igen" Command="{Binding RefreshAndroidCommand}" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Logg" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="plain" Content="Töm" Command="{Binding ClearAndroidLogCommand}" />
            </Grid>
          </StackPanel>
          <ListBox ItemsSource="{Binding AndroidLog}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Background="#F8FAFC" />
        </DockPanel>
      </Border>

      <!-- KÖRNINGAR -->
      <Border Classes="card" IsVisible="{Binding IsDrives}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="Körningar" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Spela in när du drar i reglagen, eller spela upp en sparad körning. Under uppspelning får OBD (och Android) exakt samma värden varje gång." />

            <!-- Inspelning -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="260" Text="{Binding RecordName}" Watermark="Namn på körningen" IsEnabled="{Binding !IsRecording}" />
              <Button Classes="primary" Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordCommand}" IsEnabled="{Binding CanRecord}" />
              <Button Classes="plain" Content="Importera …" Click="ImportDriveClick" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding RecordStatus}" />

            <!-- Uppspelning -->
            <Border CornerRadius="10" Padding="14,10" Background="{StaticResource AccentSoft}" IsVisible="{Binding IsPlayingDrive}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding PlayingName, StringFormat='Spelar upp: {0}'}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding DrivePositionText}" FontWeight="SemiBold" />
                </Grid>
                <Slider Minimum="0" Maximum="{Binding DriveDuration}" Value="{Binding DrivePosition}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="{Binding PlayButtonText}" Command="{Binding PlayPauseDriveCommand}" CommandParameter="{x:Null}" />
                  <Button Classes="plain" Content="⏹ Stoppa" Command="{Binding StopDriveCommand}" />
                  <ComboBox ItemsSource="{Binding DriveRates}" SelectedIndex="{Binding DriveRateIndex}" Width="80" />
                  <CheckBox Content="Slinga" IsChecked="{Binding DriveLoop}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding DriveMessage}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Drives}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DriveItemViewModel">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Classes="muted" Text="{Binding Description}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Info}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="primary" Content="▶ Spela upp"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PlayPauseDriveCommand}" CommandParameter="{Binding}" />
                        <TextBox Width="170" Text="{Binding EditName}" />
                        <Button Classes="plain" Content="Byt namn"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RenameDriveCommand}" CommandParameter="{Binding}" />
                        <Button Classes="plain" Content="Exportera …" Click="ExportDriveClick" Tag="{Binding}" />
                        <Button Classes="plain" Content="Ta bort"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDriveCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- KARTA -->
      <Border Classes="card" IsVisible="{Binding IsMap}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="Karta och GPS" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding MapHelp}" />
            <WrapPanel Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding MapClickModes}" SelectedIndex="{Binding MapClickMode}" Width="230" Margin="0,0,8,8" />
              <Button Classes="primary" Content="▶ Kör rutten" Command="{Binding StartRouteCommand}" Margin="0,0,8,8" />
              <Button Classes="plain" Content="Rensa rutt" Command="{Binding ClearRouteCommand}" Margin="0,0,8,8" />
              <Button Classes="plain" Content="Installera kartapp i Android (Organic Maps)" Command="{Binding InstallMapAppCommand}" Margin="0,0,8,8" />
              <CheckBox Content="Följ bilen" IsChecked="{Binding FollowCar}" Margin="0,0,16,8" />
              <CheckBox Content="Skicka GPS till Android" IsChecked="{Binding SendGpsToAndroid}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding GpsStatus}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="muted" Text="Kartrutor:" VerticalAlignment="Center" />
                <TextBox Width="420" Text="{Binding MapTileUrl}" FontSize="12" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                         Text="Kartdata © OpenStreetMap-bidragsgivare (ODbL). OpenStreetMaps egna rutor får bara användas måttligt för utveckling – den sålda produkten behöver en kommersiell kartleverantör." />
            </StackPanel>
          </Border>
          <Border CornerRadius="10" ClipToBounds="True">
            <views:OsmMapControl x:Name="Map"
                                 CarPosition="{Binding CarPosition}" CarBearing="{Binding CarBearing}"
                                 Route="{Binding MapRoute}" FollowCar="{Binding FollowCar, Mode=TwoWay}"
                                 TileUrl="{Binding MapTileUrl}" />
          </Border>
        </DockPanel>
      </Border>

      <!-- TESTFALL -->
      <Border Classes="card" IsVisible="{Binding IsTests}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="Testfall" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Kör ett testfall medan appen i Android (eller en telefon via Wi-Fi/Bluetooth) är ansluten till OBD. Cyberdrome ändrar bilens värden och felkoder enligt stegen och kontrollerar sedan i OBD-trafiken att appen gjorde rätt. Resultatet sparas som rapport (HTML och JSON)." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding TestCases}" SelectedItem="{Binding SelectedTest}" Width="320" IsEnabled="{Binding CanRunTest}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="obdt:TestCase">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="primary" Content="▶ Kör testet" Command="{Binding RunTestCommand}" IsEnabled="{Binding CanRunTest}" />
              <Button Classes="plain" Content="⏹ Avbryt" Command="{Binding StopTestCommand}" IsVisible="{Binding IsTestRunning}" />
              <Button Classes="plain" Content="Importera testfall …" Click="ImportTestClick" IsEnabled="{Binding CanRunTest}" />
              <Button Classes="plain" Content="Exportera som mall …" Click="ExportTestClick" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SelectedTestInfo}" />
            <ProgressBar Minimum="0" Maximum="100" Height="8" Value="{Binding TestProgress}" IsVisible="{Binding IsTestRunning}" />
            <TextBlock Text="{Binding TestInstruction}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TestSummary}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Foreground="{Binding TestSummaryColor}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTestReport}">
              <Button Classes="plain" Content="Öppna rapporten" Command="{Binding OpenTestReportCommand}" />
              <Button Classes="plain" Content="Öppna mappen med rapporter" Command="{Binding OpenReportFolderCommand}" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding TestResultRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckRow">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                    <Grid ColumnDefinitions="*,170">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Excerpt}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Foreground="#475569" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- BILMODELLER -->
      <Border Classes="card" IsVisible="{Binding IsCars}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <TextBlock Classes="h2" Text="Bilmodeller" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="De sex inbyggda bilmodellerna är skrivskyddade. Gör en kopia för att ändra namn, VIN, PID:ar, startvärden, styrdon, kodning, dolda funktioner, felkoder, skärm och tema. Dela en bilmodell som .cbs-fil (med eget tema, skal och testfall). Delade filer får inte innehålla riktiga tillverkares seed/key-algoritmer." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SelectedProfile.ListName, StringFormat='Vald: {0}'}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel IsEnabled="{Binding !IsEditingCar}">
              <Button Classes="primary" Margin="0,0,8,8" Content="Ny bilmodell från kopia" Command="{Binding NewCarFromCopyCommand}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Redigera" Command="{Binding EditCarCommand}" IsEnabled="{Binding SelectedIsOwn}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Ta bort" Command="{Binding DeleteCarCommand}" IsEnabled="{Binding SelectedIsOwn}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Exportera bilmodell …" Click="ExportCarClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Importera bilmodell …" Click="ImportCarClick" />
              <CheckBox Margin="0,0,8,8" x:Name="ExportWithCoding" IsChecked="True" Content="Exportera med nuvarande kodning" />
            </WrapPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Standardformat: ASAM ODX 2.2 (.pdx/.odx-d, ISO 22901) för styrdon, kodning och felkoder · COVESA VSS (JSON) för bilens värden · Torque/Car Scanner-CSV för egna PID:ar · felkodstexter som CSV (P0300;Text). Inbyggda modeller ändras inte – import av CSV skapar en kopia." />
            <WrapPanel IsEnabled="{Binding !IsEditingCar}">
              <Button Classes="plain" Margin="0,0,8,8" Content="Exportera ODX (.pdx) …" Click="ExportOdxClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Felkodstexter (CSV) …" Click="ImportDtcTextsClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Importera PID:ar (CSV) …" Click="ImportPidsClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Exportera PID:ar (CSV) …" Click="ExportPidsClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Importera signaler (OBDb-JSON) …" Click="ImportObdbJsonClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Exportera värden (VSS) …" Click="ExportVssClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Importera värden (VSS) …" Click="ImportVssClick" />
            </WrapPanel>
            <TextBlock Text="{Binding CarStatus}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Redigerare -->
          <ScrollViewer IsVisible="{Binding IsEditingCar}">
            <StackPanel DataContext="{Binding CarEditor}" x:DataType="vm:CarEditorViewModel" Spacing="8" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
              <Grid ColumnDefinitions="130,*,130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                <TextBlock Text="Märke" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Make}" />
                <TextBlock Grid.Column="2" Text="Modell" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding Model}" />
                <TextBlock Grid.Row="1" Text="Generation" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Generation}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Årsmodell" VerticalAlignment="Center" /><NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding Year}" Minimum="1996" Maximum="2100" FormatString="0" />
                <TextBlock Grid.Row="2" Text="Id" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Id}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="VIN (17 tecken)" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Vin}" FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="3" Text="Felkoder vid start" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StartDtcs}" Watermark="t.ex. P0300, U0100" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="PID:ar (hex)" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="3" Text="{Binding SupportedPids}" Watermark="tomt = alla" />
                <TextBlock Grid.Row="4" Text="Skärmförval" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ScreenPreset}" Watermark="t.ex. 10in-1280x800" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Tema" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Theme}" Watermark="t.ex. vw-golf8" />
                <TextBlock Grid.Row="5" Text="Startvärden" VerticalAlignment="Center" />
                <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
                  <TextBox Width="90" Text="{Binding DefSpeed}" Watermark="km/h" />
                  <TextBox Width="90" Text="{Binding DefRpm}" Watermark="rpm" />
                  <TextBox Width="90" Text="{Binding DefCoolant}" Watermark="°C" />
                  <TextBox Width="90" Text="{Binding DefFuel}" Watermark="bränsle %" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding KnownPidsText}" />

              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Styrdon (ECU)" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="plain" Content="+ Styrdon" Command="{Binding AddEcuCommand}" /></Grid>
              <ItemsControl ItemsSource="{Binding Ecus}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EcuRow">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                      <TextBox Width="100" Text="{Binding Key}" Watermark="nyckel" />
                      <TextBox Width="190" Text="{Binding Name}" Watermark="namn" />
                      <TextBox Width="60" Text="{Binding RequestId}" Watermark="fråga" />
                      <TextBox Width="60" Text="{Binding ResponseId}" Watermark="svar" />
                      <TextBox Width="110" Text="{Binding Coding}" Watermark="kodning hex" FontFamily="Consolas,Menlo,monospace" />
                      <TextBox Width="70" Text="{Binding CodingDid}" Watermark="DID" />
                      <Button Classes="plain" Content="✕" Command="{Binding $parent[ItemsControl].((vm:CarEditorViewModel)DataContext).RemoveEcuCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Dolda funktioner" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="plain" Content="+ Funktion" Command="{Binding AddFeatureCommand}" /></Grid>
              <ItemsControl ItemsSource="{Binding Features}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FeatureRow">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                      <TextBox Width="120" Text="{Binding Id}" Watermark="id" />
                      <TextBox Width="200" Text="{Binding Name}" Watermark="namn" />
                      <TextBox Width="100" Text="{Binding Ecu}" Watermark="styrdon" />
                      <NumericUpDown Width="110" Value="{Binding Byte}" Minimum="0" Maximum="3" FormatString="0" />
                      <NumericUpDown Width="110" Value="{Binding Bit}" Minimum="0" Maximum="7" FormatString="0" />
                      <TextBox Width="220" Text="{Binding Description}" Watermark="beskrivning" />
                      <Button Classes="plain" Content="✕" Command="{Binding $parent[ItemsControl].((vm:CarEditorViewModel)DataContext).RemoveFeatureCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding Errors}" Foreground="#DC2626" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,12">
                <Button Classes="primary" Content="Spara" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveCarCommand}" />
                <Button Classes="plain" Content="Avbryt" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelCarEditCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- OBD-KÄLLA -->
      <Border Classes="card" IsVisible="{Binding IsSource}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,0,12,0">
            <TextBlock Classes="h2" Text="OBD-källa" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Välj om apparna (i Android, telefonen via Wi-Fi/Bluetooth) ska prata med den virtuella bilen eller med en riktig bil via en ELM327-kompatibel adapter (t.ex. vLinker, OBDLink, Vgate). Läsläge är standard: allt som kan ändra något i bilen stoppas." />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton GroupName="src" Content="Virtuell bil" IsChecked="{Binding !SourceIsReal}" />
              <RadioButton GroupName="src" Content="Riktig adapter (vidarekoppla appar till bilen)" IsChecked="{Binding SourceIsReal}" IsEnabled="{Binding AdapterConnected}" />
            </StackPanel>

            <TextBlock Text="Adapter" FontWeight="SemiBold" Margin="0,6,0,0" />
            <WrapPanel IsEnabled="{Binding !AdapterConnected}">
              <ComboBox ItemsSource="{Binding AdapterKinds}" SelectedIndex="{Binding AdapterKindIndex}" Width="280" Margin="0,0,8,8" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsComKind}" Margin="0,0,8,8">
                <ComboBox ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}" Width="120" />
                <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}" Width="110" />
                <Button Classes="plain" Content="Uppdatera" Command="{Binding RefreshComPortsCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBtKind}" Margin="0,0,8,8">
                <ComboBox ItemsSource="{Binding BtDevices}" SelectedItem="{Binding SelectedBtDevice}" Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="app:AdapterDevice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="plain" Content="Sök Bluetooth" Command="{Binding ScanBluetoothCommand}" IsEnabled="{Binding !AdapterBusy}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWifiKind}" Margin="0,0,8,8">
                <TextBox Text="{Binding WifiHost}" Width="160" />
                <TextBox Text="{Binding WifiPort}" Width="80" />
              </StackPanel>
            </WrapPanel>
            <WrapPanel>
              <Button Classes="primary" Margin="0,0,8,8" Content="{Binding AdapterConnected, Converter={x:Static vm:Conv.ConnectText}}" Command="{Binding ConnectAdapterCommand}" IsEnabled="{Binding !AdapterBusy}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Identifiera adapter" Command="{Binding IdentifyAdapterCommand}" IsEnabled="{Binding !AdapterBusy}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Läs riktig bil" Command="{Binding ScanRealCarCommand}" IsEnabled="{Binding CanUseAdapter}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="Skapa virtuell bil från riktig bil" Command="{Binding CreateCarFromScanCommand}" IsEnabled="{Binding CanUseAdapter}" />
              <CheckBox Margin="0,0,8,8" Content="Dölj VIN-serienummer" IsChecked="{Binding HideVinSerial}" />
              <CheckBox Margin="0,0,8,8" Content="Visa livevärden" IsChecked="{Binding LiveValues}" IsEnabled="{Binding AdapterConnected}" />
            </WrapPanel>
            <TextBlock Text="{Binding AdapterStatus}" FontWeight="Medium" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LiveText}" FontSize="16" FontWeight="SemiBold" IsVisible="{Binding LiveValues}" />
            <TextBox Text="{Binding ScanText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12" MinHeight="120" IsVisible="{Binding ScanText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Background="#FEF3C7" CornerRadius="10" Padding="12" Margin="0,8,0,0">
              <StackPanel Spacing="6">
                <CheckBox Content="Tillåt skrivning för den här sessionen" IsChecked="{Binding AllowWrites}" IsEnabled="{Binding AdapterConnected}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Varning: skrivning kan ändra eller skada styrdon. Ha motorn avstängd, tändningen på och en stabil batterispänning (minst 12,0 V – annars stoppas skrivningen). Varje skrivning visar en bekräftelse med styrdon, tjänst och data, och originalvärdet sparas först i %AppData%\Cyberdrome\backup. Cyberdrome räknar aldrig ut tillverkares säkerhetsnycklar (UDS 27) – nyckeln måste komma från appen. Stängs av när adaptern kopplas från." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- BILDATABAS -->
      <Border Classes="card" IsVisible="{Binding IsCarDb}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <TextBlock Classes="h2" Text="Bildatabas" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Sök bilmodeller och avkoda VIN. Databasen är en lokal fil (%AppData%\Cyberdrome\bildatabas.db) som du fyller från öppna källor: NHTSA vPIC (märken, modeller per år, VIN – mest bilar sålda i USA), Wikidata (modellnamn även för europeiska bilar) och OBDb (tillverkarsignaler per modell). Det som hämtats fungerar utan internet." />
            <WrapPanel IsEnabled="{Binding CanUseCarDb}">
              <TextBox Text="{Binding CarDbQuery}" Watermark="Sök, t.ex. toyota rav4" Width="260" Margin="0,0,8,8" />
              <TextBox Text="{Binding CarDbYear}" Watermark="År" Width="80" Margin="0,0,8,8" />
              <Button Classes="primary" Content="Sök" Command="{Binding SearchCarDbCommand}" IsDefault="True" Margin="0,0,16,8" />
              <TextBox Text="{Binding CarDbVin}" Watermark="VIN (17 tecken)" Width="220" Margin="0,0,8,8" />
              <Button Classes="plain" Content="Avkoda VIN" Command="{Binding DecodeVinCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <WrapPanel IsEnabled="{Binding CanUseCarDb}">
              <Button Classes="plain" Content="Hämta bilmärken (vPIC)" Command="{Binding FetchCarMakesCommand}" Margin="0,0,8,8" />
              <TextBox Text="{Binding CarDbMake}" Watermark="Märke" Width="140" Margin="0,0,8,8" />
              <TextBox Text="{Binding CarDbFrom}" Width="70" Margin="0,0,4,8" />
              <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,4,8" />
              <TextBox Text="{Binding CarDbTo}" Width="70" Margin="0,0,8,8" />
              <Button Classes="plain" Content="Hämta modeller (vPIC)" Command="{Binding FetchCarModelsCommand}" Margin="0,0,8,8" />
              <Button Classes="plain" Content="Hämta modeller (Wikidata)" Command="{Binding FetchWikidataCommand}" Margin="0,0,16,8" />
              <Button Classes="plain" Content="Hämta fordonslista (OBDb)" Command="{Binding FetchObdbListCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <Border Background="#EEF2FF" CornerRadius="10" Padding="10">
              <StackPanel Spacing="6">
                <TextBlock Text="Hittar du inte modellen? Skapa en standard-OBD-bil (OBD-II-PID:ar, VIN, felkoder) – tillverkarsignaler kan läggas till senare." TextWrapping="Wrap" FontWeight="Medium" />
                <WrapPanel IsEnabled="{Binding CanUseCarDb}">
                  <TextBox Text="{Binding StdMake}" Watermark="Märke" Width="140" Margin="0,0,8,0" />
                  <TextBox Text="{Binding StdModel}" Watermark="Modell" Width="160" Margin="0,0,8,0" />
                  <TextBox Text="{Binding StdYear}" Watermark="År" Width="80" Margin="0,0,8,0" />
                  <Button Classes="plain" Content="Skapa standard-OBD-bil" Command="{Binding CreateStandardCarCommand}" Margin="0,0,8,0" />
                  <Button Classes="plain" Content="Lägg till signaler (Bilmodeller) …" Command="{Binding GoToCarsCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding CarDbStatus}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <WrapPanel>
              <Button Classes="primary" Content="Skapa bilmodell" Command="{Binding CreateCarFromDbCommand}" IsEnabled="{Binding HasCarDbHit}" Margin="0,0,8,0" />
              <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="Gör en egen bilmodell med standard-PID:ar, OBDb:s tillverkarsignaler (mode 21/22) och skärm/tema från närmaste inbyggda modell." />
            </WrapPanel>
            <TextBlock Classes="muted" FontSize="11" Text="{Binding ObdbAttribution, StringFormat='Källor: NHTSA vPIC (öppen data, USA:s trafiksäkerhetsverk) · Wikidata (CC0) · {0}'}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <ListBox ItemsSource="{Binding CarDbHits}" SelectedItem="{Binding SelectedCarDbHit}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="cardb:CarDbHit"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBox Grid.Column="1" Text="{Binding CarDbDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
          </Grid>
        </DockPanel>
      </Border>

      <!-- INSTÄLLNINGAR -->
      <Border Classes="card" IsVisible="{Binding IsSettings}" VerticalAlignment="Top">
        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Classes="h2" Text="Inställningar" />
          <TextBlock Text="Uppdateringar" FontWeight="SemiBold" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox Text="{Binding UpdateFolder}" Width="420" ToolTip.Tip="Mapp med uppdateringspaket (Velopack). Ingen server används." />
            <Button Classes="plain" Content="Sök efter uppdateringar" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !UpdateBusy}" />
            <Button Classes="primary" Content="Installera uppdatering" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding !UpdateBusy}" />
          </StackPanel>
          <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontWeight="Medium" />
          <TextBlock Text="Utseende per bilmodell" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Tema = startskärmen inne i Android (Cyberdrome Launcher). Skal = ramen/instrumentbrädan runt skärmen. Valen sparas per bilmodell; standard är bilens eget. Formerna och färgerna är inspirerade av respektive märke men ritade av oss – inga logotyper eller märkesgrafik." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Tema:" VerticalAlignment="Center" Width="50" />
            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" Width="340" />
            <Button Classes="plain" Content="Ladda upp eget tema …" Click="ImportThemeClick" />
            <Button Classes="plain" Content="Använd igen" Command="{Binding ReapplyLookCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Skal:" VerticalAlignment="Center" Width="50" />
            <ComboBox ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding SelectedSkinOption}" Width="340" />
            <Button Classes="plain" Content="Ladda upp eget skal …" Click="ImportSkinClick" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding LookStatus}" />
          <Border Height="1" Background="{StaticResource Line}" Margin="0,6" />

          <TextBlock Text="Skärm" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Storlek och upplösning på bilradions/surfplattans skärm. Byts direkt i emulatorn och sparas till nästa start." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox ItemsSource="{Binding ScreenPresetList}" SelectedItem="{Binding SelectedScreenPreset}" Width="320" />
            <RadioButton GroupName="ScreenOrientation" Content="Liggande" IsChecked="{Binding ScreenLandscape}" />
            <RadioButton GroupName="ScreenOrientation" Content="Stående" IsChecked="{Binding ScreenPortrait}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomScreen}">
            <TextBlock Text="Bredd" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding CustomScreenWidth}" Minimum="320" Maximum="4096" Increment="8" FormatString="0" Width="130" />
            <TextBlock Text="Höjd" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding CustomScreenHeight}" Minimum="320" Maximum="4096" Increment="8" FormatString="0" Width="130" />
            <TextBlock Text="dpi" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding CustomScreenDpi}" Minimum="80" Maximum="640" Increment="1" FormatString="0" Width="110" />
            <Button Classes="primary" Content="Använd" Command="{Binding ApplyCustomScreenCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ScreenLabel}" FontWeight="Medium" />
          <TextBlock Classes="muted" Text="{Binding ScreenStatus}" />
          <Border Height="1" Background="{StaticResource Line}" Margin="0,6" />

          <TextBlock Text="Android-läge" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Välj hur Android körs. Det går inte att byta medan något installeras eller startas." />
          <StackPanel Spacing="4" IsEnabled="{Binding CanChangeMode}">
            <RadioButton GroupName="AndroidMode" IsChecked="{Binding ModeNoRestart}" FontWeight="Medium"
                         Content="Utan omstart (Googles emulator, för utveckling)" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,10"
                       Text="Kör Googles Android Automotive-emulator direkt i Windows med Windows Hypervisor Platform. Ingen omstart behövs och den är snabb. Appar i emulatorn når OBD på 10.0.2.2:35000. OBS: Googles emulatoravbilder får inte följa med i den sålda produkten." />
            <RadioButton GroupName="AndroidMode" IsChecked="{Binding ModeGoogle}" FontWeight="Medium"
                         Content="Android med Google-appar (Play Store, Google Maps) – Googles emulator, för utveckling" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,10"
                       Text="Som läget ovan men med Googles appar, t.ex. Google Maps (som följer GPS:en från Cyberdrome). Laddar ner Googles avbild (ca 1,4 GB) och skapar en egen virtuell bil – den vanliga påverkas inte. Play Store kräver Google-inloggning. OBS: Googles appar och avbilder är bara för utveckling enligt Googles licens och får inte följa med den sålda produkten." />
            <RadioButton GroupName="AndroidMode" IsChecked="{Binding ModeFast}" FontWeight="Medium"
                         Content="Snabbt – WSL2 + Cuttlefish (riktig AOSP)" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0"
                       Text="Kräver en omstart av datorn första gången, om Windows funktion Virtual Machine Platform inte redan är påslagen. Sedan snabbt varje gång." />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
