<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cyberdrome.App.ViewModels"
        xmlns:p="using:Cyberdrome.Core.Profiles"
        xmlns:avm="using:Cyberdrome.Vm"
        xmlns:views="using:Cyberdrome.App.Views"
        xmlns:obdt="using:Cyberdrome.Obd.Testing"
        xmlns:app="using:Cyberdrome.App"
        xmlns:l="using:Cyberdrome.App"
        xmlns:cardb="using:Cyberdrome.Core.CarDb"
        x:Class="Cyberdrome.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cyberdrome Simulator"
        Icon="/Assets/cyberdrome.ico"
        Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!-- Toppfält -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Accent}">
            <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Cyberdrome Simulator" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding VersionText}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="40,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{l:T Ui_CarModel}" Classes="muted" VerticalAlignment="Center" FontSize="14" />
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="280" CornerRadius="10">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="p:CarProfile">
                <TextBlock Text="{Binding ListName}" FontWeight="Medium" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <Border Classes="pill" Classes.off="{Binding !Ignition}" Padding="12,7">
            <TextBlock Text="{Binding CarRunningText}" FontSize="13" />
          </Border>
          <Button Classes="plain" Content="{l:T Ui_About}" Click="AboutClick" />
          <Button Classes="plain" Content="{l:T Ui_Licence}" Click="LicenseClick" />
          <Button Classes="primary" Content="{l:T Ui_StartAndroid}" Command="{Binding StartAndroidCommand}" IsVisible="{Binding AndroidReady}" />
          <Button Classes="primary" Content="{l:T Ui_InstallAndroid}" Command="{Binding InstallAndroidCommand}" IsVisible="{Binding AndroidCanInstall}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Statusrad -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
      <StackPanel Orientation="Horizontal" Spacing="24">
        <TextBlock Classes="muted" Text="{Binding AndroidStatusShort, StringFormat='● {0}'}" />
        <TextBlock Classes="muted" Text="{Binding ObdStatus, StringFormat='● {0}'}" />
        <TextBlock Classes="muted" Text="{Binding SelectedProfile.DisplayName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_StatusCarModel}" />
      </StackPanel>
    </Border>

    <!-- Sidomeny -->
    <Border DockPanel.Dock="Left" Width="230" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,18">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="12"
                   Text="{l:T Ui_AllCarModelsAndCodingData}" />
        <ListBox Classes="nav" ItemsSource="{Binding PageKeys}" SelectedIndex="{Binding PageIndex}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PageItem">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Innehåll -->
    <Grid Margin="22">
      <Border Classes="card" IsVisible="{Binding HasError}" Background="{StaticResource WarnSoft}" VerticalAlignment="Top">
        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
      </Border>

      <!-- ÖVERSIKT -->
      <Grid ColumnDefinitions="*,380" ColumnSpacing="20" IsVisible="{Binding IsOverview}">
        <Border Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4">
              <TextBlock Classes="h2" Text="{l:T Ui_AndroidInTheCar}" />
              <TextBlock Classes="muted" Text="{l:T Ui_TheCarSScreenIsShown}" />
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <ComboBox ItemsSource="{Binding ScreenPresetList}" SelectedItem="{Binding SelectedScreenPreset}" Width="290" />
                <RadioButton GroupName="ScreenOrientationQuick" Content="{l:T Ui_Landscape}" IsChecked="{Binding ScreenLandscape}" />
                <RadioButton GroupName="ScreenOrientationQuick" Content="{l:T Ui_Portrait}" IsChecked="{Binding ScreenPortrait}" />
                <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding ScreenLabel}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <TextBlock Text="{l:T Ui_ThemeInAndroid}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" Width="300" />
                <TextBlock Text="{l:T Ui_Skin}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding SelectedSkinOption}" Width="270" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding LookStatus}" />
            </StackPanel>
            <!-- Knappar under skärmen (emulatorläget, Android igång) -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
              <WrapPanel Orientation="Horizontal" IsVisible="{Binding CanControlScreen}">
                <Button Classes="primary" Margin="0,0,8,8" Content="{l:T Ui_InstallApp}" Click="PickApk" />
                <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_InstallCyberdromeRadio}" Command="{Binding InstallRadioAppCommand}"
                        ToolTip.Tip="{l:T Ui_OurExampleAppRadioSteeringWheel}" />
                <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_InstallTestAppAndrOBD}" Command="{Binding InstallTestAppCommand}"
                        ToolTip.Tip="{l:T Ui_FreeOBDAppGPLv3FromF}" />
                <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_InstallMapAppOrganicMaps}" Command="{Binding InstallMapAppCommand}"
                        ToolTip.Tip="{l:T Ui_FreeMapAppApache20}" />
                <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_RestartApp}" Command="{Binding RestartForegroundAppCommand}" />
                <Button Classes="plain" Margin="0,0,16,8" Content="{l:T Ui_TakeScreenshot}" Command="{Binding TakeScreenshotCommand}" />
                <TextBlock Classes="muted" Text="{l:T Ui_SteeringWheelButtons}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <Button Classes="plain" Margin="0,0,6,8" Content="{l:T Ui_Previous}" ToolTip.Tip="KEYCODE_MEDIA_PREVIOUS"
                        Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Previous}" />
                <Button Classes="plain" Margin="0,0,6,8" Content="{l:T Ui_Next}" ToolTip.Tip="KEYCODE_MEDIA_NEXT"
                        Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Next}" />
                <Button Classes="plain" Margin="0,0,6,8" Content="{l:T Ui_Mute}" ToolTip.Tip="KEYCODE_VOLUME_MUTE"
                        Command="{Binding SteeringKeyCommand}" CommandParameter="{x:Static avm:SteeringButton.Mute}" />
              </WrapPanel>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding ScreenshotStatus}" IsVisible="{Binding CanControlScreen}" TextWrapping="Wrap" />
              <Border CornerRadius="10" Padding="12,10" Background="{StaticResource AccentSoft}" IsVisible="{Binding TestAppHelpVisible}">
                <TextBlock Text="{Binding TestAppHelp}" TextWrapping="Wrap" FontSize="12" />
              </Border>
              <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding HasScreenFrame}" TextWrapping="Wrap"
                         Text="{Binding AndroidObdAddress, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_ObdForAndroidApps}" />
            </StackPanel>
            <views:SkinHost x:Name="SkinFrame" Margin="0,16,0,0" Skin="{Binding ActiveSkin}">
              <Grid>
              <!-- Den levande Android-skärmen -->
              <Image x:Name="AndroidScreen" Source="{Binding ScreenFrame}" Stretch="Uniform" Cursor="Hand"
                     IsVisible="{Binding HasScreenFrame}"
                     PointerPressed="ScreenPointerPressed" PointerReleased="ScreenPointerReleased" />
              <Border CornerRadius="10" Background="#F1F5F9" IsVisible="{Binding ShowScreenPlaceholder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="460">
                  <TextBlock Text="{Binding AndroidStatusShort}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Classes="muted" TextAlignment="Center" Text="{Binding AndroidStatus}" />
                  <StackPanel Spacing="6" IsVisible="{Binding InstallProgressVisible}" MinWidth="320">
                    <ProgressBar Minimum="0" Maximum="100" Height="8" CornerRadius="4"
                                 Value="{Binding InstallProgressValue}" IsIndeterminate="{Binding InstallProgressIndeterminate}" />
                    <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                               Text="{Binding InstallProgressText}" />
                  </StackPanel>
                  <TextBlock Classes="muted" TextAlignment="Center"
                             Text="{l:T Ui_YouCanAlreadyTestOBDConnect}" />
                  <Button Classes="primary" HorizontalAlignment="Center" Content="{l:T Ui_ShowTheAndroidScreen}" Command="{Binding OpenAndroidScreenCommand}" IsVisible="{Binding AndroidRunning}" />
                  <Border CornerRadius="10" Background="White" Padding="14,10" HorizontalAlignment="Center">
                    <SelectableTextBlock Text="{Binding ObdAddress}" FontFamily="Consolas,Menlo,monospace" FontSize="15" />
                  </Border>
                  <StackPanel Spacing="4" IsVisible="{Binding HasAndroidObdAddress}" HorizontalAlignment="Center">
                    <TextBlock Classes="muted" TextAlignment="Center" Text="{l:T Ui_OBDAddressForAppsInsideThe}" />
                    <Border CornerRadius="10" Background="White" Padding="14,10" HorizontalAlignment="Center">
                      <SelectableTextBlock Text="{Binding AndroidObdAddress}" FontFamily="Consolas,Menlo,monospace" FontSize="15" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                </ScrollViewer>
              </Border>
              </Grid>
            </views:SkinHost>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
          <StackPanel Spacing="16">
            <!-- Bilen just nu -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{l:T Ui_TheCarRightNow}" />
                <TextBlock Classes="muted" Text="{l:T Ui_DragToChangeAndroidAndOBD}" />
                <Border CornerRadius="8" Padding="10,6" Background="{StaticResource WarnSoft}" IsVisible="{Binding IsPlayingDrive}">
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontWeight="SemiBold" Text="{Binding PlayingName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_PlaybackRunning}" />
                </Border>
                <Grid ColumnDefinitions="90,*,70" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2" IsEnabled="{Binding ManualControl}">
                  <TextBlock Text="{l:T Ui_Speed}" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="250" Value="{Binding Speed}" />
                  <TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat='{}{0:0} km/h'}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="1" Text="{l:T Ui_EngineSpeed}" VerticalAlignment="Center" />
                  <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="7000" Value="{Binding Rpm}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Rpm, StringFormat='{}{0:0}'}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="2" Text="{l:T Ui_Coolant}" VerticalAlignment="Center" />
                  <Slider Grid.Row="2" Grid.Column="1" Minimum="-20" Maximum="130" Value="{Binding Coolant}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Coolant, StringFormat='{}{0:0} °C'}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="3" Text="{l:T Ui_Fuel}" VerticalAlignment="Center" />
                  <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Fuel}" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Fuel, StringFormat='{}{0:0} %'}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding ManualControl}">
                  <TextBlock Text="{l:T Ui_Gear}" Width="84" VerticalAlignment="Center" />
                  <RadioButton GroupName="gear" Content="P" IsChecked="{Binding GearP}" />
                  <RadioButton GroupName="gear" Content="R" IsChecked="{Binding GearR}" />
                  <RadioButton GroupName="gear" Content="N" IsChecked="{Binding GearN}" />
                  <RadioButton GroupName="gear" Content="D" IsChecked="{Binding GearD}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20" IsEnabled="{Binding ManualControl}">
                  <ToggleSwitch IsChecked="{Binding Ignition}" OnContent="{l:T Ui_Ignition}" OffContent="{l:T Ui_Ignition}" />
                  <ToggleSwitch IsChecked="{Binding Dark}" OnContent="{l:T Ui_Dark}" OffContent="{l:T Ui_Dark}" />
                </StackPanel>
                <Separator />
                <TextBlock Text="{l:T Ui_TroubleCodes}" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding DtcText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding NewDtc}" Watermark="{l:T Ui_EGP0301}" Width="120" />
                  <Button Classes="plain" Content="{l:T Ui_Add}" Command="{Binding AddDtcCommand}" />
                  <Button Classes="plain" Content="{l:T Ui_Clear}" Command="{Binding ClearDtcsCommand}" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="12" Text="{l:T Ui_QuickPicksCommonTroubleCodes}" />
                <ItemsControl ItemsSource="{Binding DtcToggles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DtcToggleViewModel">
                      <CheckBox IsChecked="{Binding IsOn}" Content="{Binding Label}" FontSize="12" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- OBD -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="{l:T Ui_VirtualOBD}" />
                  <Border Grid.Column="1" Classes="pill" Classes.off="{Binding !ObdRunning}">
                    <TextBlock Text="{Binding ObdRunning, Converter={x:Static vm:Conv.OnOff}}" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding ObdStatus}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{l:T Ui_AppearsAsAnOrdinaryWiFi}" />
                <TextBlock Text="{Binding ObdClients}" FontWeight="Medium" />
                <TextBlock Classes="muted" Text="{Binding ObdLastAnswer}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="plain" Content="{l:T Ui_Start}" Command="{Binding StartObdCommand}" IsEnabled="{Binding !ObdRunning}" />
                  <Button Classes="plain" Content="{l:T Ui_Stop}" Command="{Binding StopObdCommand}" IsEnabled="{Binding ObdRunning}" />
                </StackPanel>
                <!-- Bluetooth -->
                <Border Height="1" Background="{StaticResource Line}" Margin="0,4" />
                <ToggleSwitch IsChecked="{Binding BluetoothEnabled}" IsEnabled="{Binding BluetoothSupported}"
                              Content="{l:T Ui_BluetoothOBDII}" OnContent="{l:T Ui_On}" OffContent="{l:T Ui_Off}" />
                <TextBlock Text="{Binding BluetoothStatus}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding BluetoothEnabled}"
                           Text="{Binding BluetoothName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_AndroidPairing}" />
                <ToggleSwitch IsChecked="{Binding BleEnabled}" IsEnabled="{Binding BluetoothSupported}"
                              Content="{l:T Ui_BluetoothLEIPhone}" OnContent="{l:T Ui_On}" OffContent="{l:T Ui_Off}" />
                <TextBlock Text="{Binding BleStatus}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding BleEnabled}"
                           Text="{l:T Ui_IPhoneNoPairingInTheIOS}" />
              </StackPanel>
            </Border>

            <!-- Dolda funktioner kort -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{l:T Ui_HiddenFeatures}" />
                <TextBlock Classes="muted" Text="{Binding FeatureSummary}" />
                <Grid ColumnDefinitions="*,Auto">
                  <Border Classes="pill"><TextBlock Text="{Binding FeatureOnText}" /></Border>
                  <Button Grid.Column="1" Classes="plain" Content="{l:T Ui_Open}" Click="OpenFeatures" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- DOLDA FUNKTIONER -->
      <Border Classes="card" IsVisible="{Binding IsFeatures}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="{l:T Ui_HiddenFeatures}" />
              <TextBlock Classes="muted" Text="{l:T Ui_TurnOnOrOffAnOBD}" />
              <TextBlock Classes="muted" Text="{Binding CarInfo}" />
              <CheckBox Margin="0,6,0,0" IsChecked="{Binding RequireSecurityAccess}"
                        Content="{l:T Ui_RequireSecurityKeyUDS27}"
                        ToolTip.Tip="{l:T Ui_OnCodingWith2ERequires10}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="plain" Content="{l:T Ui_ResetToFactory}" Command="{Binding ResetCodingCommand}" VerticalAlignment="Top" />
          </Grid>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Features}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FeatureViewModel">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Classes="muted" Text="{Binding Description}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Where}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" OnContent="{l:T Ui_On}" OffContent="{l:T Ui_Off}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- OBD-LOGG -->
      <Border Classes="card" IsVisible="{Binding IsLog}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="{l:T Ui_OBDLog}" />
              <TextBlock Classes="muted" Text="{l:T Ui_RequestFromTheAppReplyFrom}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="plain" Content="{l:T Ui_ClearTheLog}" Command="{Binding ClearLogCommand}" />
          </Grid>
          <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas,Menlo,monospace" FontSize="13" Background="#F8FAFC" />
        </DockPanel>
      </Border>

      <!-- ANDROID -->
      <Border Classes="card" IsVisible="{Binding IsAndroid}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Classes="h2" Text="{l:T Ui_Android}" />
            <TextBlock Text="{Binding AndroidStatus}" FontWeight="Medium" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding AndroidModeText}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Ui_TheFirstInstallationDownloadsSeveralGB}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasAndroidObdAddress}"
                       Text="{Binding AndroidObdAddress, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_ObdAddressEmulator}" />
            <Border CornerRadius="10" Padding="12,10" Background="{StaticResource AccentSoft}" IsVisible="{Binding TestAppHelpVisible}">
              <TextBlock Text="{Binding TestAppHelp}" TextWrapping="Wrap" FontSize="12" />
            </Border>
            <!-- Bekräftelse innan ett steg som kräver omstart -->
            <Border CornerRadius="10" Padding="14,12" IsVisible="{Binding ConfirmVisible}" Background="{StaticResource WarnSoft}">
              <StackPanel Spacing="10">
                <TextBlock Text="{l:T Ui_TheComputerNeedsToRestart}" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="{l:T Ui_Continue}" Command="{Binding ConfirmContinueCommand}" />
                  <Button Classes="plain" Content="{l:T Ui_Cancel}" Command="{Binding ConfirmCancelCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- Förloppsstapel för installation/nedladdning -->
            <Border CornerRadius="10" Padding="14,12" IsVisible="{Binding InstallProgressVisible}"
                    Background="{StaticResource AccentSoft}" Classes.done="{Binding InstallDone}">
              <Border.Styles>
                <Style Selector="Border.done"><Setter Property="Background" Value="{StaticResource OkSoft}" /></Style>
                <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>
                <Style Selector="Border.done ProgressBar"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
              </Border.Styles>
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding InstallProgressText}" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding InstallProgressPercentText}" FontWeight="SemiBold" Margin="12,0,0,0" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Height="10" CornerRadius="5"
                             Value="{Binding InstallProgressValue}" IsIndeterminate="{Binding InstallProgressIndeterminate}" />
              </StackPanel>
            </Border>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary" Margin="0,0,8,8" Content="{l:T Ui_InstallAndroid}" Command="{Binding InstallAndroidCommand}" IsEnabled="{Binding AndroidCanInstall}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_Start}" Command="{Binding StartAndroidCommand}" IsEnabled="{Binding AndroidReady}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_Stop}" Command="{Binding StopAndroidCommand}" IsEnabled="{Binding AndroidRunning}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ShowTheScreen}" Command="{Binding OpenAndroidScreenCommand}" IsEnabled="{Binding AndroidRunning}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_InstallAppAPK}" Click="PickApk" IsEnabled="{Binding AndroidRunning}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_InstallCyberdromeRadio}" Command="{Binding InstallRadioAppCommand}" IsEnabled="{Binding CanControlScreen}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_InstallTestAppAndrOBD}" Command="{Binding InstallTestAppCommand}" IsEnabled="{Binding CanControlScreen}"
                      ToolTip.Tip="{l:T Ui_FreeOBDAppGPLv3FromF}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_CheckAgain}" Command="{Binding RefreshAndroidCommand}" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{l:T Ui_Log}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="plain" Content="{l:T Ui_Clear2}" Command="{Binding ClearAndroidLogCommand}" />
            </Grid>
          </StackPanel>
          <ListBox ItemsSource="{Binding AndroidLog}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Background="#F8FAFC" />
        </DockPanel>
      </Border>

      <!-- KÖRNINGAR -->
      <Border Classes="card" IsVisible="{Binding IsDrives}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="{l:T Ui_Drives}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{l:T Ui_RecordWhileYouMoveTheSliders}" />

            <!-- Inspelning -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="260" Text="{Binding RecordName}" Watermark="{l:T Ui_NameOfTheDrive}" IsEnabled="{Binding !IsRecording}" />
              <Button Classes="primary" Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordCommand}" IsEnabled="{Binding CanRecord}" />
              <Button Classes="plain" Content="{l:T Ui_Import}" Click="ImportDriveClick" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding RecordStatus}" />

            <!-- Uppspelning -->
            <Border CornerRadius="10" Padding="14,10" Background="{StaticResource AccentSoft}" IsVisible="{Binding IsPlayingDrive}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding PlayingName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_PlayingDrive}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding DrivePositionText}" FontWeight="SemiBold" />
                </Grid>
                <Slider Minimum="0" Maximum="{Binding DriveDuration}" Value="{Binding DrivePosition}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="{Binding PlayButtonText}" Command="{Binding PlayPauseDriveCommand}" CommandParameter="{x:Null}" />
                  <Button Classes="plain" Content="{l:T Ui_Stop2}" Command="{Binding StopDriveCommand}" />
                  <ComboBox ItemsSource="{Binding DriveRates}" SelectedIndex="{Binding DriveRateIndex}" Width="80" />
                  <CheckBox Content="{l:T Ui_Loop}" IsChecked="{Binding DriveLoop}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding DriveMessage}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Drives}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DriveItemViewModel">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Classes="muted" Text="{Binding Description}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Info}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="primary" Content="{l:T Ui_Play}"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PlayPauseDriveCommand}" CommandParameter="{Binding}" />
                        <TextBox Width="170" Text="{Binding EditName}" />
                        <Button Classes="plain" Content="{l:T Ui_Rename}"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RenameDriveCommand}" CommandParameter="{Binding}" />
                        <Button Classes="plain" Content="{l:T Ui_Export}" Click="ExportDriveClick" Tag="{Binding}" />
                        <Button Classes="plain" Content="{l:T Ui_Delete}"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDriveCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- KARTA -->
      <Border Classes="card" IsVisible="{Binding IsMap}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="{l:T Ui_MapAndGPS}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding MapHelp}" />
            <WrapPanel Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding MapClickModes}" SelectedIndex="{Binding MapClickMode}" Width="230" Margin="0,0,8,8" />
              <Button Classes="primary" Content="{l:T Ui_DriveTheRoute}" Command="{Binding StartRouteCommand}" Margin="0,0,8,8" />
              <Button Classes="plain" Content="{l:T Ui_ClearRoute}" Command="{Binding ClearRouteCommand}" Margin="0,0,8,8" />
              <Button Classes="plain" Content="{l:T Ui_InstallMapAppInAndroidOrganic}" Command="{Binding InstallMapAppCommand}" Margin="0,0,8,8" />
              <CheckBox Content="{l:T Ui_FollowTheCar}" IsChecked="{Binding FollowCar}" Margin="0,0,16,8" />
              <CheckBox Content="{l:T Ui_SendGPSToAndroid}" IsChecked="{Binding SendGpsToAndroid}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding GpsStatus}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="muted" Text="{l:T Ui_MapTiles}" VerticalAlignment="Center" />
                <TextBox Width="420" Text="{Binding MapTileUrl}" FontSize="12" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                         Text="{l:T Ui_MapDataOpenStreetMapContributorsODbLOpenStreetMap}" />
            </StackPanel>
          </Border>
          <Border CornerRadius="10" ClipToBounds="True">
            <views:OsmMapControl x:Name="Map"
                                 CarPosition="{Binding CarPosition}" CarBearing="{Binding CarBearing}"
                                 Route="{Binding MapRoute}" FollowCar="{Binding FollowCar, Mode=TwoWay}"
                                 TileUrl="{Binding MapTileUrl}" />
          </Border>
        </DockPanel>
      </Border>

      <!-- TESTFALL -->
      <Border Classes="card" IsVisible="{Binding IsTests}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="{l:T Ui_TestCases}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{l:T Ui_RunATestCaseWhileThe}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding TestCases}" SelectedItem="{Binding SelectedTest}" Width="320" IsEnabled="{Binding CanRunTest}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="obdt:TestCase">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="primary" Content="{l:T Ui_RunTheTest}" Command="{Binding RunTestCommand}" IsEnabled="{Binding CanRunTest}" />
              <Button Classes="plain" Content="{l:T Ui_Cancel2}" Command="{Binding StopTestCommand}" IsVisible="{Binding IsTestRunning}" />
              <Button Classes="plain" Content="{l:T Ui_ImportTestCase}" Click="ImportTestClick" IsEnabled="{Binding CanRunTest}" />
              <Button Classes="plain" Content="{l:T Ui_ExportAsTemplate}" Click="ExportTestClick" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SelectedTestInfo}" />
            <ProgressBar Minimum="0" Maximum="100" Height="8" Value="{Binding TestProgress}" IsVisible="{Binding IsTestRunning}" />
            <TextBlock Text="{Binding TestInstruction}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TestSummary}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Foreground="{Binding TestSummaryColor}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTestReport}">
              <Button Classes="plain" Content="{l:T Ui_OpenTheReport}" Command="{Binding OpenTestReportCommand}" />
              <Button Classes="plain" Content="{l:T Ui_OpenTheReportsFolder}" Command="{Binding OpenReportFolderCommand}" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding TestResultRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckRow">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                    <Grid ColumnDefinitions="*,170">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Excerpt}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Foreground="#475569" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- BILMODELLER -->
      <Border Classes="card" IsVisible="{Binding IsCars}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <TextBlock Classes="h2" Text="{l:T Ui_CarModels}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{l:T Ui_TheSixBuiltInCarModels}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SelectedProfile.ListName, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_Selected}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel IsEnabled="{Binding !IsEditingCar}">
              <Button Classes="primary" Margin="0,0,8,8" Content="{l:T Ui_NewCarModelFromCopy}" Command="{Binding NewCarFromCopyCommand}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_Edit}" Command="{Binding EditCarCommand}" IsEnabled="{Binding SelectedIsOwn}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_Delete}" Command="{Binding DeleteCarCommand}" IsEnabled="{Binding SelectedIsOwn}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ExportCarModel}" Click="ExportCarClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ImportCarModel}" Click="ImportCarClick" />
              <CheckBox Margin="0,0,8,8" x:Name="ExportWithCoding" IsChecked="True" Content="{l:T Ui_ExportWithCurrentCoding}" />
            </WrapPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{l:T Ui_StandardFormatsASAMODX22}" />
            <WrapPanel IsEnabled="{Binding !IsEditingCar}">
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ExportODXPdx}" Click="ExportOdxClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_TroubleCodeTextsCSV}" Click="ImportDtcTextsClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ImportPIDsCSV}" Click="ImportPidsClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ExportPIDsCSV}" Click="ExportPidsClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ImportSignalsOBDbJSON}" Click="ImportObdbJsonClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ExportValuesVSS}" Click="ExportVssClick" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ImportValuesVSS}" Click="ImportVssClick" />
            </WrapPanel>
            <TextBlock Text="{Binding CarStatus}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Redigerare -->
          <ScrollViewer IsVisible="{Binding IsEditingCar}">
            <StackPanel DataContext="{Binding CarEditor}" x:DataType="vm:CarEditorViewModel" Spacing="8" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
              <Grid ColumnDefinitions="130,*,130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                <TextBlock Text="{l:T Ui_Make}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Make}" />
                <TextBlock Grid.Column="2" Text="{l:T Ui_Model}" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding Model}" />
                <TextBlock Grid.Row="1" Text="{l:T Ui_Generation}" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Generation}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:T Ui_ModelYear}" VerticalAlignment="Center" /><NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding Year}" Minimum="1996" Maximum="2100" FormatString="0" />
                <TextBlock Grid.Row="2" Text="{l:T Ui_Id}" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Id}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{l:T Ui_VIN17Characters}" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Vin}" FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Grid.Row="3" Text="{l:T Ui_TroubleCodesAtStart}" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StartDtcs}" Watermark="{l:T Ui_EGP0300U0100}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{l:T Ui_PIDsHex}" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="3" Text="{Binding SupportedPids}" Watermark="{l:T Ui_EmptyAll}" />
                <TextBlock Grid.Row="4" Text="{l:T Ui_ScreenPreset}" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ScreenPreset}" Watermark="{l:T Ui_EG10in1280x800}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{l:T Ui_Theme}" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Theme}" Watermark="{l:T Ui_EGVwGolf8}" />
                <TextBlock Grid.Row="5" Text="{l:T Ui_StartValues}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
                  <TextBox Width="90" Text="{Binding DefSpeed}" Watermark="km/h" />
                  <TextBox Width="90" Text="{Binding DefRpm}" Watermark="rpm" />
                  <TextBox Width="90" Text="{Binding DefCoolant}" Watermark="°C" />
                  <TextBox Width="90" Text="{Binding DefFuel}" Watermark="{l:T Ui_Fuel2}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding KnownPidsText}" />

              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:T Ui_ControlUnitsECU}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="plain" Content="{l:T Ui_ControlUnit}" Command="{Binding AddEcuCommand}" /></Grid>
              <ItemsControl ItemsSource="{Binding Ecus}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EcuRow">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                      <TextBox Width="100" Text="{Binding Key}" Watermark="{l:T Ui_Key}" />
                      <TextBox Width="190" Text="{Binding Name}" Watermark="{l:T Ui_Name}" />
                      <TextBox Width="60" Text="{Binding RequestId}" Watermark="{l:T Ui_Request}" />
                      <TextBox Width="60" Text="{Binding ResponseId}" Watermark="{l:T Ui_Response}" />
                      <TextBox Width="110" Text="{Binding Coding}" Watermark="{l:T Ui_CodingHex}" FontFamily="Consolas,Menlo,monospace" />
                      <TextBox Width="70" Text="{Binding CodingDid}" Watermark="DID" />
                      <Button Classes="plain" Content="✕" Command="{Binding $parent[ItemsControl].((vm:CarEditorViewModel)DataContext).RemoveEcuCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:T Ui_HiddenFeatures}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="plain" Content="{l:T Ui_Feature}" Command="{Binding AddFeatureCommand}" /></Grid>
              <ItemsControl ItemsSource="{Binding Features}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FeatureRow">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                      <TextBox Width="120" Text="{Binding Id}" Watermark="{l:T Ui_Id2}" />
                      <TextBox Width="200" Text="{Binding Name}" Watermark="{l:T Ui_Name}" />
                      <TextBox Width="100" Text="{Binding Ecu}" Watermark="{l:T Ui_ControlUnit2}" />
                      <NumericUpDown Width="110" Value="{Binding Byte}" Minimum="0" Maximum="3" FormatString="0" />
                      <NumericUpDown Width="110" Value="{Binding Bit}" Minimum="0" Maximum="7" FormatString="0" />
                      <TextBox Width="220" Text="{Binding Description}" Watermark="{l:T Ui_Description}" />
                      <Button Classes="plain" Content="✕" Command="{Binding $parent[ItemsControl].((vm:CarEditorViewModel)DataContext).RemoveFeatureCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding Errors}" Foreground="#DC2626" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,12">
                <Button Classes="primary" Content="{l:T Ui_Save}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveCarCommand}" />
                <Button Classes="plain" Content="{l:T Ui_Cancel}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelCarEditCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- OBD-KÄLLA -->
      <Border Classes="card" IsVisible="{Binding IsSource}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,0,12,0">
            <TextBlock Classes="h2" Text="{l:T Ui_OBDSource}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{l:T Ui_ChooseWhetherTheAppsInAndroid}" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton GroupName="src" Content="{l:T Ui_VirtualCar}" IsChecked="{Binding !SourceIsReal}" />
              <RadioButton GroupName="src" Content="{l:T Ui_RealAdapterBridgeAppsToThe}" IsChecked="{Binding SourceIsReal}" IsEnabled="{Binding AdapterConnected}" />
            </StackPanel>

            <TextBlock Text="{l:T Ui_Adapter}" FontWeight="SemiBold" Margin="0,6,0,0" />
            <WrapPanel IsEnabled="{Binding !AdapterConnected}">
              <ComboBox ItemsSource="{Binding AdapterKinds}" SelectedIndex="{Binding AdapterKindIndex}" Width="280" Margin="0,0,8,8" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsComKind}" Margin="0,0,8,8">
                <ComboBox ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}" Width="120" />
                <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}" Width="110" />
                <Button Classes="plain" Content="{l:T Ui_Refresh}" Command="{Binding RefreshComPortsCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBtKind}" Margin="0,0,8,8">
                <ComboBox ItemsSource="{Binding BtDevices}" SelectedItem="{Binding SelectedBtDevice}" Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="app:AdapterDevice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="plain" Content="{l:T Ui_ScanBluetooth}" Command="{Binding ScanBluetoothCommand}" IsEnabled="{Binding !AdapterBusy}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWifiKind}" Margin="0,0,8,8">
                <TextBox Text="{Binding WifiHost}" Width="160" />
                <TextBox Text="{Binding WifiPort}" Width="80" />
              </StackPanel>
            </WrapPanel>
            <WrapPanel>
              <Button Classes="primary" Margin="0,0,8,8" Content="{Binding AdapterConnected, Converter={x:Static vm:Conv.ConnectText}}" Command="{Binding ConnectAdapterCommand}" IsEnabled="{Binding !AdapterBusy}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_IdentifyAdapter}" Command="{Binding IdentifyAdapterCommand}" IsEnabled="{Binding !AdapterBusy}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_ReadRealCar}" Command="{Binding ScanRealCarCommand}" IsEnabled="{Binding CanUseAdapter}" />
              <Button Classes="plain" Margin="0,0,8,8" Content="{l:T Ui_CreateVirtualCarFromRealCar}" Command="{Binding CreateCarFromScanCommand}" IsEnabled="{Binding CanUseAdapter}" />
              <CheckBox Margin="0,0,8,8" Content="{l:T Ui_HideVINSerialNumber}" IsChecked="{Binding HideVinSerial}" />
              <CheckBox Margin="0,0,8,8" Content="{l:T Ui_ShowLiveValues}" IsChecked="{Binding LiveValues}" IsEnabled="{Binding AdapterConnected}" />
            </WrapPanel>
            <TextBlock Text="{Binding AdapterStatus}" FontWeight="Medium" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LiveText}" FontSize="16" FontWeight="SemiBold" IsVisible="{Binding LiveValues}" />
            <TextBox Text="{Binding ScanText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12" MinHeight="120" IsVisible="{Binding ScanText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Background="#FEF3C7" CornerRadius="10" Padding="12" Margin="0,8,0,0">
              <StackPanel Spacing="6">
                <CheckBox Content="{l:T Ui_AllowWritingForThisSession}" IsChecked="{Binding AllowWrites}" IsEnabled="{Binding AdapterConnected}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="{l:T Ui_WarningWritingCanChangeOrDamage}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- BILDATABAS -->
      <Border Classes="card" IsVisible="{Binding IsCarDb}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <TextBlock Classes="h2" Text="{l:T Ui_CarDatabase}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{l:T Ui_SearchCarModelsAndDecodeVINs}" />
            <WrapPanel IsEnabled="{Binding CanUseCarDb}">
              <TextBox Text="{Binding CarDbQuery}" Watermark="{l:T Ui_SearchEGToyotaRav4}" Width="260" Margin="0,0,8,8" />
              <TextBox Text="{Binding CarDbYear}" Watermark="{l:T Ui_Year}" Width="80" Margin="0,0,8,8" />
              <Button Classes="primary" Content="{l:T Ui_Search}" Command="{Binding SearchCarDbCommand}" IsDefault="True" Margin="0,0,16,8" />
              <TextBox Text="{Binding CarDbVin}" Watermark="{l:T Ui_VIN17Characters}" Width="220" Margin="0,0,8,8" />
              <Button Classes="plain" Content="{l:T Ui_DecodeVIN}" Command="{Binding DecodeVinCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <WrapPanel IsEnabled="{Binding CanUseCarDb}">
              <Button Classes="plain" Content="{l:T Ui_GetMakesVPIC}" Command="{Binding FetchCarMakesCommand}" Margin="0,0,8,8" />
              <TextBox Text="{Binding CarDbMake}" Watermark="{l:T Ui_Make}" Width="140" Margin="0,0,8,8" />
              <TextBox Text="{Binding CarDbFrom}" Width="70" Margin="0,0,4,8" />
              <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,4,8" />
              <TextBox Text="{Binding CarDbTo}" Width="70" Margin="0,0,8,8" />
              <Button Classes="plain" Content="{l:T Ui_GetModelsVPIC}" Command="{Binding FetchCarModelsCommand}" Margin="0,0,8,8" />
              <Button Classes="plain" Content="{l:T Ui_GetModelsWikidata}" Command="{Binding FetchWikidataCommand}" Margin="0,0,16,8" />
              <Button Classes="plain" Content="{l:T Ui_GetVehicleListOBDb}" Command="{Binding FetchObdbListCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <Border Background="#EEF2FF" CornerRadius="10" Padding="10">
              <StackPanel Spacing="6">
                <TextBlock Text="{l:T Ui_CanTFindTheModelCreate}" TextWrapping="Wrap" FontWeight="Medium" />
                <WrapPanel IsEnabled="{Binding CanUseCarDb}">
                  <TextBox Text="{Binding StdMake}" Watermark="{l:T Ui_Make}" Width="140" Margin="0,0,8,0" />
                  <TextBox Text="{Binding StdModel}" Watermark="{l:T Ui_Model}" Width="160" Margin="0,0,8,0" />
                  <TextBox Text="{Binding StdYear}" Watermark="{l:T Ui_Year}" Width="80" Margin="0,0,8,0" />
                  <Button Classes="plain" Content="{l:T Ui_CreateStandardOBDCar}" Command="{Binding CreateStandardCarCommand}" Margin="0,0,8,0" />
                  <Button Classes="plain" Content="{l:T Ui_AddSignalsCarModels}" Command="{Binding GoToCarsCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding CarDbStatus}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <WrapPanel>
              <Button Classes="primary" Content="{l:T Ui_CreateCarModel}" Command="{Binding CreateCarFromDbCommand}" IsEnabled="{Binding HasCarDbHit}" Margin="0,0,8,0" />
              <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:T Ui_MakeYourOwnCarModelWith}" />
            </WrapPanel>
            <TextBlock Classes="muted" FontSize="11" Text="{Binding ObdbAttribution, Converter={x:Static vm:Conv.Format}, ConverterParameter=Fmt_CarDbSources}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <ListBox ItemsSource="{Binding CarDbHits}" SelectedItem="{Binding SelectedCarDbHit}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="cardb:CarDbHit"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBox Grid.Column="1" Text="{Binding CarDbDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
          </Grid>
        </DockPanel>
      </Border>

      <!-- INSTÄLLNINGAR -->
      <Border Classes="card" IsVisible="{Binding IsSettings}" VerticalAlignment="Top">
        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Classes="h2" Text="{l:T Ui_Settings}" />
          <TextBlock Text="{l:T Settings_Language}" FontWeight="SemiBold" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" Width="220" />
            <TextBlock Text="{l:T Settings_LanguageHelp}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
          </StackPanel>
          <TextBlock Text="{l:T Ui_Updates}" FontWeight="SemiBold" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox Text="{Binding UpdateFolder}" Width="420" ToolTip.Tip="{l:T Ui_FolderWithUpdatePackagesVelopackNo}" />
            <Button Classes="plain" Content="{l:T Ui_CheckForUpdates}" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !UpdateBusy}" />
            <Button Classes="primary" Content="{l:T Ui_InstallUpdate}" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding !UpdateBusy}" />
          </StackPanel>
          <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontWeight="Medium" />
          <TextBlock Text="{l:T Ui_LookPerCarModel}" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Ui_ThemeTheHomeScreenInsideAndroid}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{l:T Ui_Theme2}" VerticalAlignment="Center" Width="50" />
            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" Width="340" />
            <Button Classes="plain" Content="{l:T Ui_UploadYourOwnTheme}" Click="ImportThemeClick" />
            <Button Classes="plain" Content="{l:T Ui_ApplyAgain}" Command="{Binding ReapplyLookCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{l:T Ui_Skin}" VerticalAlignment="Center" Width="50" />
            <ComboBox ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding SelectedSkinOption}" Width="340" />
            <Button Classes="plain" Content="{l:T Ui_UploadYourOwnSkin}" Click="ImportSkinClick" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding LookStatus}" />
          <Border Height="1" Background="{StaticResource Line}" Margin="0,6" />

          <TextBlock Text="{l:T Ui_Screen}" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Ui_SizeAndResolutionOfTheCar}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox ItemsSource="{Binding ScreenPresetList}" SelectedItem="{Binding SelectedScreenPreset}" Width="320" />
            <RadioButton GroupName="ScreenOrientation" Content="{l:T Ui_Landscape}" IsChecked="{Binding ScreenLandscape}" />
            <RadioButton GroupName="ScreenOrientation" Content="{l:T Ui_Portrait}" IsChecked="{Binding ScreenPortrait}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomScreen}">
            <TextBlock Text="{l:T Ui_Width}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding CustomScreenWidth}" Minimum="320" Maximum="4096" Increment="8" FormatString="0" Width="130" />
            <TextBlock Text="{l:T Ui_Height}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding CustomScreenHeight}" Minimum="320" Maximum="4096" Increment="8" FormatString="0" Width="130" />
            <TextBlock Text="dpi" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding CustomScreenDpi}" Minimum="80" Maximum="640" Increment="1" FormatString="0" Width="110" />
            <Button Classes="primary" Content="{l:T Ui_Apply}" Command="{Binding ApplyCustomScreenCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ScreenLabel}" FontWeight="Medium" />
          <TextBlock Classes="muted" Text="{Binding ScreenStatus}" />
          <Border Height="1" Background="{StaticResource Line}" Margin="0,6" />

          <TextBlock Text="{l:T Ui_AndroidMode}" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Ui_ChooseHowAndroidRunsItCannot}" />
          <StackPanel Spacing="4" IsEnabled="{Binding CanChangeMode}">
            <RadioButton GroupName="AndroidMode" IsChecked="{Binding ModeNoRestart}" FontWeight="Medium"
                         Content="{l:T Ui_NoRestartGoogleSEmulatorFor}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,10"
                       Text="{l:T Ui_RunsGoogleSAndroidAutomotiveEmulator}" />
            <RadioButton GroupName="AndroidMode" IsChecked="{Binding ModeGoogle}" FontWeight="Medium"
                         Content="{l:T Ui_AndroidWithGoogleAppsPlayStore}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,10"
                       Text="{l:T Ui_LikeTheModeAboveButWith}" />
            <RadioButton GroupName="AndroidMode" IsChecked="{Binding ModeFast}" FontWeight="Medium"
                         Content="{l:T Ui_FastWSL2CuttlefishRealAOSP}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0"
                       Text="{l:T Ui_RequiresARestartOfTheComputer}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
